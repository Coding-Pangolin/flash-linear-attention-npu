namespace {
GM_ADDR ScratchArg(uint8_t** data)
{
#if defined(KCP_IPC_AFFINE_RELAY) || defined(KCP_IPC_STATE_PREVIEW) || defined(KCP_IPC_BATCH_RELAY)
    return data[14];
#else
    return nullptr;
#endif
}

GM_ADDR SymmetricArg()
{
#if defined(KCP_SHMEM_UDMA)
    return kcp_shmem_arena();
#else
    return nullptr;
#endif
}

constexpr uint32_t kLaunchBlocks = kComputeOwners;
}

extern "C" int run_ipc_chunk32(void** data, uint32_t tokens, uint32_t rank, uint32_t world)
{
    if (world != 8 || rank >= 8) {
        return ACL_ERROR_INVALID_PARAM;
    }
    aclrtStream stream = nullptr;
    auto status = aclrtCreateStream(&stream);
    if (status != ACL_SUCCESS) {
        return status;
    }
    auto** bytes = reinterpret_cast<uint8_t**>(data);
    kcp_ipc_chunk32_forward<<<kLaunchBlocks, nullptr, stream>>>(
        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7], bytes[8],
        bytes[9], bytes[10], bytes[11], bytes[12], nullptr, ScratchArg(bytes), SymmetricArg(), tokens, rank, world,
        1, 1, 0);
    status = aclrtSynchronizeStreamWithTimeout(stream, 10000);
    const auto cleanup = aclrtDestroyStream(stream);
    return status == ACL_SUCCESS ? cleanup : status;
}

extern "C" void enqueue_ipc_chunk32(void** data, uint32_t tokens, uint32_t rank, uint32_t world,
                                     uint32_t epoch, aclrtStream stream)
{
    auto** bytes = reinterpret_cast<uint8_t**>(data);
    kcp_ipc_chunk32_forward<<<kLaunchBlocks, nullptr, stream>>>(
        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7], bytes[8],
        bytes[9], bytes[10], bytes[11], bytes[12], bytes[13], ScratchArg(bytes), SymmetricArg(), tokens, rank, world,
        epoch, 0, epoch - 1);
}

#if defined(KCP_IPC_FIRST_PAIR) || defined(KCP_IPC_AFFINE_RELAY_STAGGER) || defined(KCP_IPC_AFFINE_RELAY_ADVANCE)
extern "C" uint32_t kcp_ipc_rank_scratch_bytes(uint32_t rank, uint32_t world)
{
#if defined(KCP_IPC_AFFINE_RELAY_STAGGER) || defined(KCP_IPC_AFFINE_RELAY_ADVANCE)
    return world == 8 && rank < 8 ? (PayloadWorkers(rank) * kSummaryBytes + SummaryWorkers(rank) * kSummaryWorker) : 0;
#else
    return 0;
#endif
}

// Keep one fixed-size completion slot across invocations in the wrapper experiment.
extern "C" void enqueue_kda_cp_ipc(void** data, uint32_t tokens, uint32_t rank, uint32_t world,
                                   uint32_t epoch, uint32_t saveFinal, aclrtStream stream)
{
    auto** bytes = reinterpret_cast<uint8_t**>(data);
    kcp_ipc_chunk32_forward<<<kLaunchBlocks, nullptr, stream>>>(
        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7], bytes[8],
        bytes[9], bytes[10], bytes[11], bytes[12], bytes[13], ScratchArg(bytes), nullptr, tokens, rank, world,
        epoch, saveFinal, 0);
}
#endif
