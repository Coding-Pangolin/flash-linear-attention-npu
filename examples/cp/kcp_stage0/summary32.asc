#include "chunk32_summary.h"
#include "check_runtime.h"

#include <array>
#include <iomanip>

using namespace KcpSummary32;

__global__ __aicore__ void kcp_summary32_check(
    GM_ADDR k, GM_ADDR v, GM_ADDR g, GM_ADDR beta, GM_ADDR alpha, GM_ADDR bias,
    GM_ADDR em, GM_ADDR scratch, GM_ADDR meta, GM_ADDR trace)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__DAV_C310_CUBE__) || defined(__DAV_C310_VEC__)
    auto* m = reinterpret_cast<__gm__ const int64_t*>(meta);
    const Schedule schedule{static_cast<uint32_t>(m[0]), static_cast<uint32_t>(m[1]),
        static_cast<uint32_t>(m[2]), static_cast<uint32_t>(m[3]), meta + 4 * sizeof(int64_t)};
    Run({k, v, g, beta, alpha, bias, em, scratch, trace}, schedule);
#endif
}

namespace {
struct Fixture {
    uint32_t heads;
    uint32_t groups;
    std::vector<int64_t> offsets;
    std::vector<uint16_t> key;
    std::vector<uint16_t> value;
    std::vector<float> gate;
    std::vector<float> beta;
    std::vector<float> alpha;
    std::vector<float> bias;

    Fixture(const std::vector<uint32_t>& lengths, uint32_t h, uint32_t nGroups, bool weak)
        : heads(h), groups(nGroups), offsets{0}
    {
        for (uint32_t len : lengths) {
            offsets.push_back(offsets.back() + len);
        }
        const uint32_t tokens = Tokens();
        const size_t entries = static_cast<size_t>(tokens) * heads;
        key.resize(entries * kDim);
        value.resize(entries * kDim);
        gate.resize(entries * kDim);
        beta.resize(entries);
        alpha.resize(heads);
        bias.resize(heads * kDim);
        for (uint32_t head = 0; head < heads; ++head) {
            alpha[head] = std::exp((static_cast<int>(head % 7) - 3) * 0.07f);
            for (uint32_t d = 0; d < kDim; ++d) {
                bias[head * kDim + d] = (static_cast<int>((d + 5 * head) % 11) - 5) * 0.061f;
            }
            for (uint32_t t = 0; t < tokens; ++t) {
                const size_t token = static_cast<size_t>(head) * tokens + t;
                beta[token] = (static_cast<int>((t * 71 + head * 13) % 127) - 63) / 29.0f;
                for (uint32_t d = 0; d < kDim; ++d) {
                    const size_t i = token * kDim + d;
                    key[i] = ToBf16((static_cast<int>((t * 37 + d * 31 + head * 19) % 509) - 254) / 881.0f);
                    value[i] = ToBf16((static_cast<int>((t * 89 + d * 29 + head * 61) % 193) - 96) / 257.0f);
                    const float jitter = (static_cast<int>((t * 19 + d * 7 + head) % 47) - 23) / 23.0f;
                    gate[i] = weak ? -7.9f + jitter : (d % 7 == 0 ? 3.2f : -2.7f) + jitter;
                }
            }
        }
    }

    uint32_t Tokens() const { return static_cast<uint32_t>(offsets.back()); }
    uint32_t Tasks() const { return heads * static_cast<uint32_t>(offsets.size() - 1); }
};

// Independent token recurrence. The first 128 columns start at zero, the
// next 128 start at the identity and receive zero values at each token.
template<uint32_t Width>
std::vector<double> Reference(const Fixture& f, uint32_t task, bool withInitial)
{
    const uint32_t head = task % f.heads;
    const uint32_t seq = task / f.heads;
    std::vector<double> state(kDim * Width, 0);
    for (uint32_t row = 0; row < kDim; ++row) {
        if constexpr (Width == kWidth) {
            state[row * Width + kDim + row] = 1;
        }
        if (withInitial) {
            for (uint32_t j = 0; j < Width; ++j) {
                state[row * Width + j] = (static_cast<int>((row * 23 + j * 53) % 101) - 50) / 137.0;
            }
        }
    }
    for (int64_t t = f.offsets[seq]; t < f.offsets[seq + 1]; ++t) {
        const size_t token = static_cast<size_t>(head) * f.Tokens() + t;
        std::array<double, kDim> k{};
        std::array<double, Width> residual{};
        double sum = 1.0e-6;
        for (uint32_t d = 0; d < kDim; ++d) {
            k[d] = FromBf16(f.key[token * kDim + d]);
            sum += k[d] * k[d];
        }
        const double reciprocalNorm = 1.0 / std::sqrt(sum);
        for (uint32_t d = 0; d < kDim; ++d) {
            k[d] *= reciprocalNorm;
        }
        for (uint32_t j = 0; j < kDim; ++j) {
            residual[j] = FromBf16(f.value[token * kDim + j]);
        }
        for (uint32_t d = 0; d < kDim; ++d) {
            const double g = static_cast<double>(f.gate[token * kDim + d]) + f.bias[head * kDim + d];
            const double dGate = std::exp(-5.0 / (1.0 + std::exp(-f.alpha[head] * g)));
            for (uint32_t j = 0; j < Width; ++j) {
                auto& x = state[d * Width + j];
                x *= dGate;
                residual[j] -= k[d] * x;
            }
        }
        const double b = 1.0 / (1.0 + std::exp(-f.beta[token]));
        for (uint32_t d = 0; d < kDim; ++d) {
            for (uint32_t j = 0; j < Width; ++j) {
                state[d * Width + j] += k[d] * b * residual[j];
            }
        }
    }
    return state;
}

void CheckSummary(const Fixture& f, const std::vector<float>& got)
{
    float maxE = 0, maxM = 0, maxPrediction = 0;
    for (uint32_t task = 0; task < f.Tasks(); ++task) {
        const auto expected = Reference<kWidth>(f, task, false);
        const size_t base = static_cast<size_t>(task) * kPayload;
        for (uint32_t row = 0; row < kDim; ++row) {
            for (uint32_t col = 0; col < kWidth; ++col) {
                float& worst = col < kDim ? maxE : maxM;
                const uint32_t ij = row * kWidth + col;
                try {
                    worst = std::max(worst, Verify(got[base + ij], expected[ij], 0.003, 0.02,
                                                  col < kDim ? "E" : "M"));
                } catch (const std::exception&) {
                    std::cerr << "task=" << task << " row=" << row << " col=" << col << "\n";
                    throw;
                }
            }
        }
        const auto fromInitial = Reference<kDim>(f, task, true);
        for (uint32_t row = 0; row < kDim; ++row) {
            for (uint32_t col = 0; col < kDim; ++col) {
                const uint32_t entry = row * kWidth;
                double actual = got[base + entry + col];
                for (uint32_t d = 0; d < kDim; ++d) {
                    const double h0 = (static_cast<int>((d * 23 + col * 53) % 101) - 50) / 137.0;
                    actual += got[base + entry + kDim + d] * h0;
                }
                maxPrediction = std::max(maxPrediction, Verify(static_cast<float>(actual),
                    fromInitial[row * kDim + col], 0.005, 0.025, "E+M@H0"));
            }
        }
    }
    std::cout << "tokens=" << f.Tokens() << " heads=" << f.heads << " tasks=" << f.Tasks()
              << " groups=" << f.groups << " E_max_abs=" << maxE << " M_max_abs=" << maxM
              << " prediction_max_abs=" << maxPrediction << "\n";
}

void PrintTrace(const std::vector<int64_t>& trace, uint32_t pairs)
{
    std::cout << "pair,window,aiv0_prepare_start,aiv0_prepare_end,aiv1_prepare_start,aiv1_prepare_end,"
                 "aic_gemm_start,aic_gemm_end,aic_pair_done,aiv0_pair_done,aiv1_pair_done,"
                 "pack0_start,pack0_end,pack1_start,pack1_end,delta0_start,delta0_end\n";
    for (uint32_t pair = 0; pair < std::min(kTracePairs, pairs); ++pair) {
        const auto* x = trace.data() + pair * kTraceFields * kTraceStride;
        std::cout << pair << ',' << pair / 2;
        for (uint32_t i : {0u, 1u, 2u, 3u, 6u, 7u, 8u, 9u, 10u, 11u, 12u, 13u, 14u, 15u, 16u}) {
            std::cout << ',' << x[i * kTraceStride];
        }
        std::cout << "\n";
    }
}

void RunFixture(Device& device, const Fixture& f, bool profile)
{
    Buffer<uint16_t> k(f.key.size()), v(f.value.size());
    Buffer<float> g(f.gate.size()), beta(f.beta.size()), alpha(f.alpha.size()), bias(f.bias.size());
    Buffer<float> payload(static_cast<size_t>(f.Tasks()) * kPayload);
    Buffer<uint8_t> scratch(static_cast<size_t>(f.groups) * kScratchBytes);
    std::vector<int64_t> settings{f.Tokens(), f.heads, f.Tasks(), f.groups};
    settings.insert(settings.end(), f.offsets.begin(), f.offsets.end());
    Buffer<int64_t> meta(settings.size()), trace(kTracePairs * kTraceFields * kTraceStride);
    k.Write(f.key);
    v.Write(f.value);
    g.Write(f.gate);
    beta.Write(f.beta);
    alpha.Write(f.alpha);
    bias.Write(f.bias);
    meta.Write(settings);
    trace.Write(std::vector<int64_t>(kTracePairs * kTraceFields * kTraceStride));
    payload.Write(std::vector<float>(static_cast<size_t>(f.Tasks()) * kPayload, 91.0f));
    const int repeats = profile ? 5 : 2;
    for (int n = 0; n < repeats; ++n) {
        kcp_summary32_check<<<f.groups, nullptr, device.stream>>>(k.Ptr(), v.Ptr(), g.Ptr(), beta.Ptr(),
            alpha.Ptr(), bias.Ptr(), payload.Ptr(), scratch.Ptr(), meta.Ptr(), n == 0 ? trace.Ptr() : nullptr);
        Check(aclrtSynchronizeStream(device.stream), "summary32");
        if (!profile) {
            CheckSummary(f, payload.Read());
        }
    }
    PrintTrace(trace.Read(), (static_cast<uint32_t>(f.offsets[1]) + kRowsPerPair - 1) / kRowsPerPair);
}
} // namespace

int main(int argc, char** argv)
{
    try {
        Device device;
        std::cout << std::scientific << std::setprecision(6);
        if (argc == 2 && std::string(argv[1]) == "--profile") {
            RunFixture(device, Fixture({513}, 32, 27, true), true);
         } else if (argc == 2 && std::string(argv[1]) == "--profile-2048") {
            RunFixture(device, Fixture({2048}, 32, 27, true), true);
        } else if (argc == 2 && std::string(argv[1]) == "--long") {
            RunFixture(device, Fixture({8193, 129}, 1, 2, true), false);
        } else if (argc == 2 && std::string(argv[1]) == "--smoke") {
            RunFixture(device, Fixture({33, 128, 129, 1}, 1, 3, true), false);
        } else {
            RunFixture(device, Fixture({257, 1, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 128, 129}, 3, 8, false), false);
            RunFixture(device, Fixture({1025, 129, 33, 65}, 3, 7, true), false);
        }
    } catch (const std::exception& error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
    return 0;
}
