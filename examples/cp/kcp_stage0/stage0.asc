#include "chunk_preprocess.h"
#include "check_runtime.h"

#include <array>

using namespace KcpPreprocess;

extern "C" __global__ __aicore__ void kcp_stage0_check(
    GM_ADDR q, GM_ADDR k, GM_ADDR g, GM_ADDR beta, GM_ADDR aLog, GM_ADDR bias,
    GM_ADDR meta, GM_ADDR qhat, GM_ADDR khat, GM_ADDR gate, GM_ADDR betaEff)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if ASCEND_IS_AIV {
        Stage0 stage;
        stage.Run(q, k, g, beta, aLog, bias, meta, qhat, khat, gate, betaEff);
    }
}


int main()
{
    try {
        const uint32_t tokens = 139, heads = 3, groups = 5;
        const std::vector<int32_t> offsets{0, 1, 65, 130, 139};
        std::vector<int32_t> metadata{tokens, heads, static_cast<int32_t>(offsets.size() - 1), groups};
        metadata.insert(metadata.end(), offsets.begin(), offsets.end());
        const size_t rows = tokens * heads, elements = rows * kDim;
        std::vector<uint16_t> q(elements), k(elements);
        std::vector<float> g(elements), beta(rows), a(heads), bias(heads * kDim);
        for (size_t col = 0; col < bias.size(); ++col) {
            bias[col] = (static_cast<int32_t>(col % 11) - 5) / 41.0f;
        }
        for (uint32_t head = 0; head < heads; ++head) {
            a[head] = (static_cast<int32_t>(head) - 1) / 5.0f;
        }
        for (size_t row = 0; row < rows; ++row) {
            beta[row] = (static_cast<int32_t>(row % 31) - 15) / 7.0f;
            for (uint32_t col = 0; col < kDim; ++col) {
                const auto offset = row * kDim + col;
                q[offset] = ToBf16(row % 22 == 0 ? 0.0f : (static_cast<int32_t>(offset % 47) - 23) / 13.0f);
                k[offset] = ToBf16((static_cast<int32_t>(offset % 53) - 26) / (row % 23 == 0 ? 1e6f : 19.0f));
                g[offset] = (static_cast<int32_t>(offset % 61) - 30) / 3.0f;
            }
        }

        Device device;
        Buffer<uint16_t> dq(elements), dk(elements), dqh(elements), dkh(elements);
        Buffer<float> dg(elements), db(rows), da(heads), dbias(bias.size()), dgate(elements), dbe(rows * kBetaStride);
        Buffer<int32_t> dm(metadata.size());
        dq.Write(q);
        dk.Write(k);
        dg.Write(g);
        db.Write(beta);
        da.Write(a);
        dbias.Write(bias);
        dm.Write(metadata);
        kcp_stage0_check<<<groups, nullptr, device.stream>>>(
            dq.Ptr(), dk.Ptr(), dg.Ptr(), db.Ptr(), da.Ptr(), dbias.Ptr(),
            dm.Ptr(), dqh.Ptr(), dkh.Ptr(), dgate.Ptr(), dbe.Ptr());
        Check(aclrtSynchronizeStream(device.stream), "Stage 0 kernel");
        const auto qh = dqh.Read();
        const auto kh = dkh.Read();
        const auto gates = dgate.Read();
        const auto be = dbe.Read();

        float qError = 0, kError = 0, gateError = 0, betaError = 0;
        for (uint32_t h = 0; h < heads; ++h) {
            for (size_t s = 0; s + 1 < offsets.size(); ++s) {
                std::array<double, kDim> gateSum{};
                for (int32_t token = offsets[s]; token < offsets[s + 1]; ++token) {
                    if ((token - offsets[s]) % kChunk == 0) {
                        gateSum.fill(0);
                    }
                    const size_t row = h * tokens + token;
                    const size_t base = row * kDim;
                    double qNorm = kEpsilon, kNorm = kEpsilon;
                    for (size_t c = 0; c < kDim; ++c) {
                        const double x = FromBf16(q[base + c]);
                        const double y = FromBf16(k[base + c]);
                        qNorm += x * x;
                        kNorm += y * y;
                    }
                    for (size_t c = 0; c < kDim; ++c) {
                        const auto offset = base + c;
                        const auto normQ = FromBf16(ToBf16(FromBf16(q[offset]) / std::sqrt(qNorm)));
                        const auto normK = FromBf16(ToBf16(FromBf16(k[offset]) / std::sqrt(kNorm)));
                        const double raw = std::exp(static_cast<double>(a[h])) * (g[offset] + bias[h * kDim + c]);
                        gateSum[c] += -5.0 * std::log2(std::exp(1.0)) / (1.0 + std::exp(-raw));
                        qError = std::max(qError, Verify(FromBf16(qh[offset]), normQ, 0.0002, 0.008, "Q norm"));
                        kError = std::max(kError, Verify(FromBf16(kh[offset]), normK, 0.0002, 0.008, "K norm"));
                        gateError = std::max(gateError, Verify(gates[offset], gateSum[c], 0.00005, 0.000004, "gate scan"));
                    }
                    const double expectedBeta = 1.0 / (1.0 + std::exp(-static_cast<double>(beta[row])));
                    betaError = std::max(betaError, Verify(be[row * kBetaStride], expectedBeta, 0.000003, 0, "beta"));
                }
            }
        }
        std::cout << "stage0=PASS groups=" << groups << " heads=" << heads << " tokens=" << tokens
                  << " q_max_abs=" << qError << " k_max_abs=" << kError
                  << " gate_max_abs=" << gateError << " beta_max_abs=" << betaError << '\n';
        return 0;
    } catch (const std::exception& e) {
        std::cerr << e.what() << '\n';
        return 1;
    }
}
