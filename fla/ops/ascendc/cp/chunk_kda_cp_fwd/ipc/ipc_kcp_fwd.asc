}
#endif
#if defined(KCP_IPC_AFFINE_RELAY_ADVANCE)
#define kcp_ipc_chunk32_forward kcp_ipc_chunk32_forward_wu_per_head_overlap28_affine_resident
#elif defined(KCP_IPC_AFFINE_RELAY_STAGGER)
