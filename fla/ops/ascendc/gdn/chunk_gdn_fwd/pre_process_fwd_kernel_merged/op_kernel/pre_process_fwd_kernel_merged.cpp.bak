/*!
 * \file pre_process_fwd_kernel_merged.cpp
 * \brief CP 前处理算子 kernel 入口 + **v1（正确性优先）向量实现**。
 *
 * v1 说明（后续性能版本再替换）：
 *   * 只走 AIV（`KERNEL_TYPE_AIV_ONLY`），一个工作项 = 一条链（段 n × head hv），
 *     `h`/`m` 常驻 UB，逐 chunk 推进；
 *   * 4 个矩阵乘（`W_c@h`、`L_c^T@v_new`、`L_c^T@W_c`、`M_c@m`）用 UB 向量 FMA 手写，
 *     精度按契约（bf16 量化点、fp32 累加）严格控制，但吞吐远低于 design.md 的 Cube 方案；
 *   * 规格固定 K = V = 128、BT = 64（host 侧已拦截）。
 *   ponytail: v1 先用向量实现打通数值，性能版本按 design.md 2.2–2.6 换成 Cube/CATLASS tile。
 */

#include "kernel_operator.h"
#include "pre_process_fwd_kernel_merged_struct.h"

namespace GDN {
using namespace AscendC;

constexpr int32_t PPFM_K_DIM = 128;
constexpr int32_t PPFM_V_DIM = 128;
constexpr int32_t PPFM_BT = 64;
constexpr int32_t PPFM_KB = 32;                       // dH / Kw 的行块高
constexpr int32_t PPFM_HALF = 64;
constexpr float PPFM_LN2 = 0.6931471805599453f;

// UB 缓冲（元素数）
constexpr int32_t OFF_H = 0;                          // hF  [K,V] fp32（常驻）
constexpr int32_t OFF_M = OFF_H + PPFM_K_DIM * PPFM_V_DIM;                 // mF  [K,K] fp32（常驻）
constexpr int32_t OFF_K = OFF_M + PPFM_K_DIM * PPFM_K_DIM;                 // kUb [BT,K] bf16
constexpr int32_t OFF_W = OFF_K + PPFM_BT * PPFM_K_DIM;                    // wUb [BT,K] bf16
constexpr int32_t OFF_V = OFF_W + PPFM_BT * PPFM_K_DIM;                    // vUb [BT,V] bf16
constexpr int32_t OFF_VN = OFF_V + PPFM_BT * PPFM_V_DIM;                   // vNewBf [BT,V] bf16
constexpr int32_t OFF_BLK = OFF_VN + PPFM_BT * PPFM_V_DIM;                 // blk [KB,V] fp32
constexpr int32_t OFF_ROW1 = OFF_BLK + PPFM_KB * PPFM_V_DIM;               // row tmp fp32 [V]
constexpr int32_t OFF_ROW2 = OFF_ROW1 + PPFM_V_DIM;                        // row tmp fp32 [V]
constexpr int32_t OFF_ROW3 = OFF_ROW2 + PPFM_V_DIM;                        // row tmp fp32 [V]
constexpr int32_t OFF_DECAY = OFF_ROW3 + PPFM_V_DIM;                       // decay fp32 [K]（常驻，每 chunk 刷新）
constexpr int32_t OFF_DG = OFF_DECAY + PPFM_K_DIM;    // 逐 token 衰减 E(g_last-g_t) fp32 [BT]
constexpr int32_t OFF_EXP = OFF_DG + PPFM_BT;         // 标量 exp 的 8 元素 scratch（32B 对齐）
constexpr int32_t PPFM_EXP_LANES = 8;
constexpr int32_t PPFM_UB_FLOATS = OFF_EXP + PPFM_EXP_LANES + 128;

template <typename GT, int64_t GATE_MODE>
class PreProcessFwdKernelMergedVector {
public:
    __aicore__ inline void Init(GM_ADDR k, GM_ADDR w, GM_ADDR u, GM_ADDR g, GM_ADDR gk, GM_ADDR bg, GM_ADDR v,
                                GM_ADDR cuSeqlens, GM_ADDR hm, GM_ADDR userWorkspace,
                                const PreProcessFwdKernelMergedTilingData *tilingData)
    {
        kGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(k));
        wGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(w));
        uGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(u));
        vGm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(v == nullptr ? u : v));
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ GT *>(g));
        gkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ GT *>(gk));
        cuGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(cuSeqlens));
        hmGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(hm));
        (void)bg;
        Hk_ = tilingData->Hk;
        Hv_ = tilingData->Hv;
        hvPerHk_ = tilingData->hvPerHk;
        T_ = tilingData->T;
        K_ = tilingData->K;
        V_ = tilingData->V;
        chunkSize_ = tilingData->chunkSize;
        nSeq_ = tilingData->nSeq;
        taskNum_ = tilingData->taskNum;
        usedNum_ = tilingData->usedAicNum;
        // 每个工作项一块 GM 临时区（口径见 *_struct.h）
        wsBase_ = reinterpret_cast<__gm__ float *>(userWorkspace) +
                  static_cast<int64_t>(GetBlockIdx()) * (PPFM_CORE_WS_BYTES / sizeof(float));
        pipe_.InitBuffer(ubBuf_, PPFM_UB_FLOATS * sizeof(float));
        hF_ = ubBuf_.Get<float>();
        mF_ = ubBuf_.Get<float>()[OFF_M];
        kUb_ = ubBuf_.Get<bfloat16_t>()[OFF_K];
        wUb_ = ubBuf_.Get<bfloat16_t>()[OFF_W];
        vUb_ = ubBuf_.Get<bfloat16_t>()[OFF_V];
        vNewBf_ = ubBuf_.Get<bfloat16_t>()[OFF_VN];
        blkF_ = ubBuf_.Get<float>()[OFF_BLK];
        row1_ = ubBuf_.Get<float>()[OFF_ROW1];
        row2_ = ubBuf_.Get<float>()[OFF_ROW2];
        row3_ = ubBuf_.Get<float>()[OFF_ROW3];
        decay_ = ubBuf_.Get<float>()[OFF_DECAY];
        dg_ = ubBuf_.Get<float>()[OFF_DG];
        expScratch_ = ubBuf_.Get<float>()[OFF_EXP];
        mNewGm_ = wsBase_ + PPFM_K_DIM * PPFM_V_DIM;  // 复用同一块 GM 区的后半段
        mNewGt_.SetGlobalBuffer(mNewGm_, PPFM_K_DIM * PPFM_K_DIM);
    }

    __aicore__ inline void Process()
    {
        for (int64_t task = GetBlockIdx(); task < taskNum_; task += usedNum_) {
            const int64_t n = task / Hv_;
            const int64_t hv = task % Hv_;
            const int64_t bos = cuGm_.GetValue(n);
            const int64_t eos = cuGm_.GetValue(n + 1);
            ProcessChain(n, hv, bos, eos - bos);
        }
    }

private:
    // exp2(x) = exp(x * ln2)，向量版
    __aicore__ inline void Exp2Vec(const LocalTensor<float> &dst, const LocalTensor<float> &src, int32_t count)
    {
        Muls(dst, src, PPFM_LN2, count);
        Exp(dst, dst, count);
    }

    __aicore__ inline void ProcessChain(int64_t n, int64_t hv, int64_t bos, int64_t len)
    {
        // ---- 状态初始化：h = 0，m = I ----
        Duplicate(hF_, 0.0f, PPFM_K_DIM * PPFM_V_DIM);
        Duplicate(mF_, 0.0f, PPFM_K_DIM * PPFM_K_DIM);
        PipeBarrier<PIPE_ALL>();
        for (int32_t i = 0; i < PPFM_K_DIM; ++i) {
            mF_.SetValue(i * PPFM_K_DIM + i, 1.0f);
        }
        PipeBarrier<PIPE_ALL>();

        const int64_t hk = hv / hvPerHk_;
        const int64_t nt = (len + PPFM_BT - 1) / PPFM_BT;
        for (int64_t c = 0; c < nt; ++c) {
            const int64_t t0 = bos + c * PPFM_BT;
            const int64_t rows = (len - c * PPFM_BT) < PPFM_BT ? (len - c * PPFM_BT) : PPFM_BT;
            ProcessChunk(hk, hv, t0, rows);
        }
        // ---- 写回 hm[n, hv]：左 V 列 h，右 K 列 m ----
        PipeBarrier<PIPE_ALL>();
        const int64_t hmBase = ((n * Hv_ + hv) * PPFM_K_DIM) * (PPFM_V_DIM + PPFM_K_DIM);
        for (int32_t i = 0; i < PPFM_K_DIM; ++i) {
            DataCopy(hmGm_[hmBase + i * (PPFM_V_DIM + PPFM_K_DIM)], hF_[i * PPFM_V_DIM], PPFM_V_DIM);
        }
        PipeBarrier<PIPE_ALL>();
        for (int32_t i = 0; i < PPFM_K_DIM; ++i) {
            DataCopy(hmGm_[hmBase + i * (PPFM_V_DIM + PPFM_K_DIM) + PPFM_V_DIM], mF_[i * PPFM_K_DIM],
                     PPFM_K_DIM);
        }
        PipeBarrier<PIPE_ALL>();
    }

    // 取 gate 标量（USE_G：g[t]；USE_GK：gk[t,k]）
    __aicore__ inline float GateValue(int64_t hv, int64_t t, int32_t k) const
    {
        if (GATE_MODE == PPFM_GATE_USE_G) {
            return static_cast<float>(gGm_.GetValue(hv * T_ + t));
        }
        if (GATE_MODE == PPFM_GATE_USE_BG || GATE_MODE == PPFM_GATE_USE_GK) {
            return static_cast<float>(gkGm_.GetValue((hv * T_ + t) * PPFM_K_DIM + k));
        }
        return 0.0f;
    }

    __aicore__ inline void ProcessChunk(int64_t hk, int64_t hv, int64_t t0, int64_t rows)
    {
        // ---- 搬入 k/v/w 分片（不足 BT 的行补零）----
        PipeBarrier<PIPE_ALL>();
        Duplicate(kUb_, static_cast<bfloat16_t>(0), PPFM_BT * PPFM_K_DIM);
        Duplicate(wUb_, static_cast<bfloat16_t>(0), PPFM_BT * PPFM_K_DIM);
        Duplicate(vUb_, static_cast<bfloat16_t>(0), PPFM_BT * PPFM_V_DIM);
        PipeBarrier<PIPE_ALL>();
        DataCopy(kUb_, kGm_[(hk * T_ + t0) * PPFM_K_DIM], rows * PPFM_K_DIM);
        DataCopy(wUb_, wGm_[(hv * T_ + t0) * PPFM_K_DIM], rows * PPFM_K_DIM);
        DataCopy(vUb_, vGm_[(hv * T_ + t0) * PPFM_V_DIM], rows * PPFM_V_DIM);
        PipeBarrier<PIPE_ALL>();

        // ---- S0/S1：v_new = V_c - W_c @ bf16(h)，再按 gate 缩放并量化到 BF16 ----
        // decay[k] = E(gk_last[k])（USE_GK/BG）或 decay[0]=E(g_last)（USE_G）
        if (GATE_MODE == PPFM_GATE_USE_G) {
            const float glast = GateValue(hv, t0 + rows - 1, 0);
            // decay 向量（USE_G 时全行同值）
            const float dscalar = Exp2Scalar(glast);
            Duplicate(decay_, dscalar, PPFM_K_DIM);
            for (int64_t t = 0; t < rows; ++t) {
                dg_.SetValue(t, Exp2Scalar(glast - GateValue(hv, t0 + t, 0)));
            }
        } else {
            for (int32_t k = 0; k < PPFM_K_DIM; ++k) {
                decay_.SetValue(k, Exp2Scalar(GateValue(hv, t0 + rows - 1, k)));
            }
        }
        chunkLast_ = t0 + rows - 1;
        PipeBarrier<PIPE_ALL>();

        for (int64_t t = 0; t < rows; ++t) {
            // row1 = W_c[t,:] @ h  （h 行 r 为 hF[r*V, (r+1)*V)）
            Duplicate(row1_, 0.0f, PPFM_V_DIM);
            PipeBarrier<PIPE_V>();
            for (int32_t r = 0; r < PPFM_K_DIM; ++r) {
                const float wScalar = static_cast<float>(wUb_.GetValue(t * PPFM_K_DIM + r));
                Muls(row2_, hF_[r * PPFM_V_DIM], wScalar, PPFM_V_DIM);
                Add(row1_, row1_, row2_, PPFM_V_DIM);
            }
            PipeBarrier<PIPE_V>();
            // v_new = V_c - P（GDN/KDA），再乘 E(g_last - g_t)（USE_G）
            Cast(row2_, vUb_[t * PPFM_V_DIM], RoundMode::CAST_NONE, PPFM_V_DIM);
            Sub(row1_, row2_, row1_, PPFM_V_DIM);
            if (GATE_MODE == PPFM_GATE_USE_G) {
                Muls(row1_, row1_, dg_.GetValue(t), PPFM_V_DIM);
            }
            PipeBarrier<PIPE_V>();
            Cast(vNewBf_[t * PPFM_V_DIM], row1_, RoundMode::CAST_RINT, PPFM_V_DIM);
            PipeBarrier<PIPE_ALL>();
        }

        // ---- S2：dH = L_c^T @ bf16(v_new)；Kw = L_c^T @ W_c（按 K 行分块累加）----
        for (int32_t kb = 0; kb < PPFM_K_DIM / PPFM_KB; ++kb) {
            const int32_t kBase = kb * PPFM_KB;
            Duplicate(blkF_, 0.0f, PPFM_KB * PPFM_V_DIM);
            PipeBarrier<PIPE_V>();
            for (int64_t t = 0; t < rows; ++t) {
                for (int32_t kk = 0; kk < PPFM_KB; ++kk) {
                    const float lScalar = LValue(hv, t0 + t, kBase + kk);
                    Cast(row3_, vNewBf_[t * PPFM_V_DIM], RoundMode::CAST_NONE, PPFM_V_DIM);
                    PipeBarrier<PIPE_V>();
                    Muls(row3_, row3_, lScalar, PPFM_V_DIM);
                    Add(blkF_[kk * PPFM_V_DIM], blkF_[kk * PPFM_V_DIM], row3_, PPFM_V_DIM);
                }
            }
            PipeBarrier<PIPE_ALL>();
            // h 行块：h = decay ⊙ h + dH
            for (int32_t kk = 0; kk < PPFM_KB; ++kk) {
                const int32_t row = kBase + kk;
                const float dc = (GATE_MODE == PPFM_GATE_USE_G) ? decay_.GetValue(0) : decay_.GetValue(row);
                Muls(row2_, hF_[row * PPFM_V_DIM], dc, PPFM_V_DIM);
                Add(hF_[row * PPFM_V_DIM], row2_, blkF_[kk * PPFM_V_DIM], PPFM_V_DIM);
            }
            PipeBarrier<PIPE_ALL>();
        }

        // ---- S3/S4：M_c = diag(decay) - Kw，m = M_c @ m ----
        // Kw 按 K 行分块算：Kw[k, :] = Σ_t L[t,k] * W_c[t, :]
        for (int32_t kb = 0; kb < PPFM_K_DIM / PPFM_KB; ++kb) {
            const int32_t kBase = kb * PPFM_KB;
            Duplicate(blkF_, 0.0f, PPFM_KB * PPFM_K_DIM);
            PipeBarrier<PIPE_V>();
            for (int64_t t = 0; t < rows; ++t) {
                for (int32_t kk = 0; kk < PPFM_KB; ++kk) {
                    const float lScalar = LValue(hv, t0 + t, kBase + kk);
                    Cast(row3_, wUb_[t * PPFM_K_DIM], RoundMode::CAST_NONE, PPFM_K_DIM);
                    PipeBarrier<PIPE_V>();
                    Muls(row3_, row3_, lScalar, PPFM_K_DIM);
                    Add(blkF_[kk * PPFM_K_DIM], blkF_[kk * PPFM_K_DIM], row3_, PPFM_K_DIM);
                }
            }
            PipeBarrier<PIPE_ALL>();
            // 该 K 行块的 M_c 行乘上 m（m 为 [K,K]）：
            //   mNew[i, :] = Σ_j M_c[i, j] * m[j, :]
            for (int32_t kk = 0; kk < PPFM_KB; ++kk) {
                const int32_t row = kBase + kk;
                Duplicate(row1_, 0.0f, PPFM_K_DIM);
                PipeBarrier<PIPE_V>();
                for (int32_t j = 0; j < PPFM_K_DIM; ++j) {
                    const float mc = M_cValue(row, j, blkF_, kk);
                    Muls(row2_, mF_[j * PPFM_K_DIM], mc, PPFM_K_DIM);
                    Add(row1_, row1_, row2_, PPFM_K_DIM);
                }
                PipeBarrier<PIPE_V>();
                DataCopy(mNewGt_[row * PPFM_K_DIM], row1_, PPFM_K_DIM);
                PipeBarrier<PIPE_ALL>();
            }
        }
        // m ← mNew（整块拷回，跨 K 行块边界后统一）
        PipeBarrier<PIPE_ALL>();
        for (int32_t i = 0; i < PPFM_K_DIM; ++i) {
            DataCopy(mF_[i * PPFM_K_DIM], mNewGt_[i * PPFM_K_DIM], PPFM_K_DIM);
        }
        PipeBarrier<PIPE_ALL>();
    }

    // L[t,k]：USE_G 时为 bf16(E(g_last - g_t) * K_c[t,k])，其余为 K_c[t,k]（bf16 原值）
    __aicore__ inline float LValue(int64_t hv, int64_t t, int32_t k) const
    {
        const float kVal = static_cast<float>(kUb_.GetValue((t - chunkT0_) * PPFM_K_DIM + k));
        if (GATE_MODE == PPFM_GATE_USE_G) {
            // 契约：L_c = bf16(E(g_last - g_t) * FP32(K_c))，逐行缩放后再量化
            const bfloat16_t scaled = static_cast<bfloat16_t>(dg_.GetValue(t - chunkT0_) * kVal);
            return static_cast<float>(scaled);
        }
        return kVal;
    }

    __aicore__ inline float M_cValue(int32_t row, int32_t col, const LocalTensor<float> &kwBlk, int32_t kk) const
    {
        const float kw = kwBlk.GetValue(kk * PPFM_K_DIM + col);
        const float diag = (row == col) ? decay_.GetValue(row) : 0.0f;
        return diag - kw;
    }

    __aicore__ inline float Exp2Scalar(float x) const
    {
        // 标量 exp2 = exp(x*ln2)：借 8 元素 scratch 走一次向量 Exp（AscendC 无标量 exp）
        expScratch_.SetValue(0, x * PPFM_LN2);
        PipeBarrier<PIPE_ALL>();
        Exp(expScratch_, expScratch_, PPFM_EXP_LANES);
        PipeBarrier<PIPE_ALL>();
        return expScratch_.GetValue(0);
    }

    TPipe pipe_;
    TBuf<TPosition::VECCALC> ubBuf_;
    GlobalTensor<bfloat16_t> kGm_;
    GlobalTensor<bfloat16_t> wGm_;
    GlobalTensor<bfloat16_t> uGm_;
    GlobalTensor<bfloat16_t> vGm_;
    GlobalTensor<GT> gGm_;
    GlobalTensor<GT> gkGm_;
    GlobalTensor<int64_t> cuGm_;
    GlobalTensor<float> hmGm_;
    __gm__ float *wsBase_ = nullptr;
    __gm__ float *mNewGm_ = nullptr;
    LocalTensor<float> hF_;
    LocalTensor<float> mF_;
    LocalTensor<bfloat16_t> kUb_;
    LocalTensor<bfloat16_t> wUb_;
    LocalTensor<bfloat16_t> vUb_;
    LocalTensor<bfloat16_t> vNewBf_;
    LocalTensor<float> blkF_;
    LocalTensor<float> row1_;
    LocalTensor<float> row2_;
    LocalTensor<float> row3_;
    LocalTensor<float> decay_;
    LocalTensor<float> dg_;
    LocalTensor<float> expScratch_;
    GlobalTensor<float> mNewGt_;
    int64_t Hk_ = 0;
    int64_t Hv_ = 0;
    int64_t hvPerHk_ = 1;
    int64_t T_ = 0;
    int64_t K_ = 0;
    int64_t V_ = 0;
    int64_t chunkSize_ = PPFM_BT;
    int64_t nSeq_ = 0;
    int64_t taskNum_ = 0;
    int64_t usedNum_ = 1;
    int64_t chunkT0_ = 0;
    int64_t chunkLast_ = 0;
};

template <typename GT, int64_t GATE_MODE>
__aicore__ inline void PreProcessFwdKernelMergedLaunch(GM_ADDR k, GM_ADDR w, GM_ADDR u, GM_ADDR g, GM_ADDR gk,
                                                       GM_ADDR bg, GM_ADDR v, GM_ADDR cuSeqlens, GM_ADDR hm,
                                                       GM_ADDR userWorkspace,
                                                       const PreProcessFwdKernelMergedTilingData *tilingData)
{
    PreProcessFwdKernelMergedVector<GT, GATE_MODE> op;
    op.Init(k, w, u, g, gk, bg, v, cuSeqlens, hm, userWorkspace, tilingData);
    op.Process();
}
} // namespace GDN

extern "C" __global__ __aicore__ void pre_process_fwd_kernel_merged(GM_ADDR k, GM_ADDR w, GM_ADDR u, GM_ADDR g,
                                                                   GM_ADDR gk, GM_ADDR bg, GM_ADDR v,
                                                                   GM_ADDR cu_seqlens, GM_ADDR hm,
                                                                   GM_ADDR workspace, GM_ADDR tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    REGISTER_TILING_DEFAULT(GDN::PreProcessFwdKernelMergedTilingData);
    GET_TILING_DATA_WITH_STRUCT(GDN::PreProcessFwdKernelMergedTilingData, tilingData, tiling);
    GM_ADDR userWS = AscendC::GetUserWorkspace(workspace);
    if (userWS == nullptr) {
        return;
    }
    const bool gateIsFp32 = (tilingData.gateDtype == GDN::PPFM_DTYPE_FP32);
    if (TILING_KEY_IS(3)) {  // DPLR 预留
        if (gateIsFp32) {
            GDN::PreProcessFwdKernelMergedLaunch<float, GDN::PPFM_GATE_USE_BG>(k, w, u, g, gk, bg, v, cu_seqlens, hm,
                                                                               userWS, &tilingData);
        } else {
            GDN::PreProcessFwdKernelMergedLaunch<bfloat16_t, GDN::PPFM_GATE_USE_BG>(
                k, w, u, g, gk, bg, v, cu_seqlens, hm, userWS, &tilingData);
        }
    } else if (TILING_KEY_IS(2)) {  // USE_GK（KDA）
        if (gateIsFp32) {
            GDN::PreProcessFwdKernelMergedLaunch<float, GDN::PPFM_GATE_USE_GK>(k, w, u, g, gk, bg, v, cu_seqlens, hm,
                                                                               userWS, &tilingData);
        } else {
            GDN::PreProcessFwdKernelMergedLaunch<bfloat16_t, GDN::PPFM_GATE_USE_GK>(
                k, w, u, g, gk, bg, v, cu_seqlens, hm, userWS, &tilingData);
        }
    } else if (TILING_KEY_IS(1)) {  // USE_G（GDN）
        if (gateIsFp32) {
            GDN::PreProcessFwdKernelMergedLaunch<float, GDN::PPFM_GATE_USE_G>(k, w, u, g, gk, bg, v, cu_seqlens, hm,
                                                                              userWS, &tilingData);
        } else {
            GDN::PreProcessFwdKernelMergedLaunch<bfloat16_t, GDN::PPFM_GATE_USE_G>(
                k, w, u, g, gk, bg, v, cu_seqlens, hm, userWS, &tilingData);
        }
    }
}
