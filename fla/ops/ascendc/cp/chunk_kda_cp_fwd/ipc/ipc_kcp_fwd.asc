extern "C" uint32_t kcp_shmem_arena_bytes()
{
#if defined(KCP_SHMEM_UDMA_ONLY)
    return kShmemCreditSource + kSignalBytes;
#else
    return kShmemReadyBase + kBatches * kSignalBytes;
#endif
}
#endif
#if defined(KCP_SHMEM_UDMA_ONLY)
extern "C" int kcp_transport_owns_signals()
