namespace {
using namespace AscendC;
#include "relay_head_assignment.h"
constexpr uint32_t kOwners = 16;
constexpr uint32_t kBatches = 2;
constexpr uint32_t kHeads = kOwners * kBatches;
constexpr uint32_t kStateBytes = 128 * 128 * sizeof(float);
constexpr uint32_t kHalfElements = 64 * 128;
constexpr uint32_t kBatchBytes = kOwners * kStateBytes;
constexpr uint32_t kSignalBytes = 32;
constexpr uint32_t kSignalWords = kSignalBytes / sizeof(uint32_t);
constexpr uint32_t kSignalArea = kHeads * 2 * kSignalBytes;
constexpr uint32_t kReadyBase = kBatches * kBatchBytes;
constexpr uint32_t kCreditBase = kReadyBase + kSignalArea;
constexpr int64_t kWaitCycles = 4'000'000'000;
#if defined(KCP_IPC_BATCH_RELAY)
constexpr uint32_t kBatchSignalBytes = kSignalArea / kBatches;
constexpr uint32_t kShmemSendBase = kReadyBase;
constexpr uint32_t kShmemReadyBase = 2 * kReadyBase;
constexpr uint32_t kShmemCreditBase = kShmemReadyBase + kBatches * kSignalBytes;
constexpr uint32_t kShmemCreditPayload = kShmemCreditBase + kBatches * kSignalBytes;
constexpr uint32_t kShmemCreditSource = kShmemCreditPayload + kBatches * kSignalBytes;
constexpr uint32_t kProducedBase =
#if defined(KCP_SHMEM_UDMA_ONLY)
    0;
#else
    kReadyBase;
#endif
constexpr uint32_t kBatchWorkspaceBytes = kProducedBase + kSignalArea;
#endif

#if defined(KCP_IPC_AFFINE_RELAY)
constexpr uint32_t kSummaryBytes = 2 * kStateBytes;
constexpr uint32_t kDoubleGroups = kHeads - kComputeOwners;
constexpr uint32_t kSummaryArea = kDoubleGroups * kSummaryBytes;
__host__ __aicore__ inline uint32_t PayloadWorkers(uint32_t rank)
{
    return SummaryWorkers(rank) == 0 ? 0 : kDoubleGroups;
}
constexpr uint32_t kSummaryWorker = 1024;
// Each AIV receives 64 rows of the FP32 affine product at this UB offset.
constexpr uint32_t kMergeProductUb = 32 * 1024;
constexpr uint16_t kMergeInput = 1;
constexpr uint16_t kMergeOutput = 10;
#endif
#if defined(KCP_IPC_STATE_PREVIEW)
constexpr uint32_t kPreviewWorker = 170 * 1024;
#endif

__aicore__ inline uint32_t SignalOffset(uint32_t batch, uint32_t owner, uint32_t lane)
{
    return ((batch * kOwners + owner) * 2 + lane) * kSignalBytes;
}

__aicore__ inline bool Ready(GM_ADDR addr, uint32_t epoch)
{
    // UB is unused across tasks once the preceding forward's stores have drained.
    LocalTensor<uint32_t> line(TPosition::VECCALC, 0, kSignalWords);
    GlobalTensor<uint32_t> flag;
    flag.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(addr), kSignalWords);
    const auto start = GetSystemCycle();
    for (;;) {
        DataCopy(line, flag, kSignalWords);
        PipeBarrier<PIPE_ALL>();
        if (line.GetValue(0) == epoch) {
            return true;
        }
        if (GetSystemCycle() - start > kWaitCycles) {
            return false;
        }
    }
}

__aicore__ inline void Publish(GM_ADDR addr, uint32_t epoch)
{
    LocalTensor<uint32_t> line(TPosition::VECCALC, 0, kSignalWords);
    GlobalTensor<uint32_t> flag;
    flag.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(addr), kSignalWords);
    Duplicate(line, uint32_t{0}, kSignalWords);
    PipeBarrier<PIPE_ALL>();
    line.SetValue(0, epoch);
    PipeBarrier<PIPE_ALL>();
    DataCopy(flag, line, kSignalWords);
    PipeBarrier<PIPE_ALL>();
}

#if defined(KCP_IPC_BATCH_RELAY) && defined(__DAV_C310_VEC__)
__aicore__ inline bool WaitForBatch(GM_ADDR flags, uint32_t epoch)
{
    constexpr uint32_t words = kBatchSignalBytes / sizeof(uint32_t);
    LocalTensor<uint32_t> local(TPosition::VECCALC, 0, words);
    GlobalTensor<uint32_t> global;
    global.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(flags), words);
    const auto start = GetSystemCycle();
    do {
        DataCopy(local, global, words);
        PipeBarrier<PIPE_ALL>();
        uint32_t ready = 0;
        for (uint32_t i = 0; i < words; i += kSignalWords) {
            ready += local.GetValue(i) == epoch;
        }
        if (ready == 2 * kOwners) {
            return true;
        }
    } while (GetSystemCycle() - start <= kWaitCycles);
    return false;
}

#if !defined(KCP_SHMEM_UDMA)
__aicore__ inline void CopyBatch(GM_ADDR destination, GM_ADDR source)
{
    constexpr uint32_t tile = 64 * 1024 / sizeof(uint32_t);
    LocalTensor<uint32_t> local(TPosition::VECCALC, 0, tile);
    GlobalTensor<uint32_t> from, to;
    from.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(source));
    to.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(destination));
    for (uint32_t offset = 0; offset < kBatchBytes / sizeof(uint32_t); offset += tile) {
        DataCopy(local, from[offset], tile);
        PipeBarrier<PIPE_ALL>();
        DataCopy(to[offset], local, tile);
        PipeBarrier<PIPE_ALL>();
    }
}
#endif

#if defined(KCP_SHMEM_UDMA)
__aicore__ inline void PutWithSignal(GM_ADDR destination, GM_ADDR source, uint32_t size, GM_ADDR signal,
                                      uint32_t epoch, uint32_t peer)
{
    constexpr uint32_t bytes = ACLSHMEM_UDMA_MTE_STAGING_UB_SIZE;
    LocalTensor<uint64_t> wqe(TPosition::VECCALC, 0, bytes / sizeof(uint64_t));
    auto* ub = reinterpret_cast<__ubuf__ uint64_t*>(wqe.GetPhyAddr());
    for (uint32_t i = 0; i < bytes / sizeof(uint64_t); ++i) {
        ub[i] = 0;
    }
    aclshmemx_udma_put_signal_nbi(destination, source, size, reinterpret_cast<__gm__ uint64_t*>(signal),
                                epoch, peer, reinterpret_cast<__ubuf__ uint8_t*>(ub), 0);
    aclshmemx_udma_quiet(peer);
}
#endif

#if defined(KCP_SHMEM_UDMA_ONLY)
__aicore__ inline void ReceiveAndAcknowledge(GM_ADDR inbox, GM_ADDR symmetric, GM_ADDR status,
                                              uint32_t rank, uint32_t epoch)
{
    if (rank == 0) {
        return;
    }
    for (uint32_t batch = 0; batch < kBatches; ++batch) {
        const uint32_t flags = batch * kBatchSignalBytes;
        if (!Ready(symmetric + kShmemReadyBase + batch * kSignalBytes, epoch)) {
            return;
        }
        Publish(inbox + kReadyBase + flags, epoch);
        if (!WaitForBatch(status + (epoch - 1) * kSignalArea + flags, epoch)) {
            return;
        }
        // Completion means both Vector lanes have retired all reads of this H.
        GM_ADDR payload = symmetric + kShmemCreditPayload + batch * kSignalBytes;
        GM_ADDR credit = symmetric + kShmemCreditBase + batch * kSignalBytes;
        PutWithSignal(payload, symmetric + kShmemCreditSource, kSignalBytes, credit, epoch, rank - 1);
    }
}
#endif

__aicore__ inline void RelayBatches(GM_ADDR inbox, GM_ADDR next, GM_ADDR staging, GM_ADDR symmetric,
                                     uint32_t rank, uint32_t epoch)
{
    for (uint32_t batch = 0; batch < kBatches; ++batch) {
        const uint32_t flags = batch * kBatchSignalBytes;
#if !defined(KCP_SHMEM_UDMA_ONLY)
        if (rank > 0) {
#if defined(KCP_SHMEM_UDMA)
            GM_ADDR arrived = symmetric + kShmemReadyBase + batch * kSignalBytes;
#else
            GM_ADDR arrived = inbox + kReadyBase + flags + kSignalBytes;
#endif
            if (!Ready(arrived, epoch)) {
                return;
            }
            Publish(inbox + kReadyBase + flags, epoch);
        }
#endif
        if (next == nullptr) {
            continue;
        }
        if (!WaitForBatch(staging + kProducedBase + flags, epoch)) {
            return;
        }
#if defined(KCP_SHMEM_UDMA_ONLY)
        if (epoch > 1 && !Ready(symmetric + kShmemCreditBase + batch * kSignalBytes, epoch - 1)) {
            return;
        }
#else
        if (epoch > 1 && !WaitForBatch(inbox + kCreditBase + flags, epoch - 1)) {
            return;
        }
#endif
        const uint32_t offset = batch * kBatchBytes;
#if defined(KCP_SHMEM_UDMA)
        PutWithSignal(symmetric + offset, symmetric + kShmemSendBase + offset, kBatchBytes,
                      symmetric + kShmemReadyBase + batch * kSignalBytes, epoch, rank + 1);
#else
        CopyBatch(next + offset, staging + offset);
        Publish(next + kReadyBase + flags + kSignalBytes, epoch);
#endif
    }
}
#endif

#if defined(KCP_IPC_PHASE_TRACE)
__aicore__ inline void PublishCompletion(GM_ADDR addr, uint32_t epoch, uint32_t summary,
                                         uint32_t wait, uint32_t apply, uint32_t forward,
                                         uint32_t batchStart, uint32_t published, uint32_t preparation)
{
    LocalTensor<uint32_t> line(TPosition::VECCALC, 0, kSignalWords);
    GlobalTensor<uint32_t> result;
    result.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(addr), kSignalWords);
    line.SetValue(0, epoch);
    line.SetValue(1, summary);
    line.SetValue(2, wait);
    line.SetValue(3, apply);
    line.SetValue(4, forward);
    line.SetValue(5, batchStart);
    line.SetValue(6, published);
    line.SetValue(7, preparation);
    PipeBarrier<PIPE_ALL>();
    DataCopy(result, line, kSignalWords);
    PipeBarrier<PIPE_ALL>();
}
#endif

#if (defined(KCP_IPC_AFFINE_RELAY) || defined(KCP_IPC_STATE_PREVIEW)) && \
    (defined(__DAV_C310_CUBE__) || defined(__DAV_C310_VEC__))
__aicore__ inline void RunKSide(const KcpSummary32::Inputs& inputs, const KcpSummary32::Schedule& schedule)
{
#if defined(__DAV_C310_CUBE__)
    KcpSummary32::Run<int32_t>(inputs, schedule);
#else
    KcpSummary32::Run<int32_t, true>(inputs, schedule);
#endif
}
#endif

#if defined(KCP_IPC_STATE_PREVIEW) && (defined(__DAV_C310_CUBE__) || defined(__DAV_C310_VEC__))
static_assert(kPreviewWorker == KcpSummary32::kScratchBytes);
__aicore__ inline void PreviewState(GM_ADDR k, GM_ADDR v, GM_ADDR gate, GM_ADDR beta, GM_ADDR alpha,
                                    GM_ADDR bias, GM_ADDR offsets, GM_ADDR scratch, GM_ADDR initial,
                                    GM_ADDR output, uint32_t tokens, uint32_t batch)
{
    const KcpSummary32::Inputs inputs{k, v, gate, beta, alpha, bias, output, scratch, nullptr, initial};
    const uint32_t first = batch * kOwners;
    const KcpSummary32::Schedule schedule{tokens, kHeads, first + kOwners, kOwners, offsets, first, first};
    RunKSide(inputs, schedule);
}
#endif

#if defined(KCP_IPC_AFFINE_RELAY) && (defined(__DAV_C310_CUBE__) || defined(__DAV_C310_VEC__))
static_assert(kSummaryWorker == KcpSummary32::kScratchBytes);

__aicore__ inline void SummarizeHead(GM_ADDR k, GM_ADDR v, GM_ADDR gate, GM_ADDR beta, GM_ADDR alpha,
                                     GM_ADDR bias, GM_ADDR offsets, GM_ADDR summary, GM_ADDR worker,
                                     uint32_t tokens, uint32_t head)
{
    const KcpSummary32::Inputs inputs{k, v, gate, beta, alpha, bias, summary, worker, nullptr};
    const KcpSummary32::Schedule schedule{tokens, kHeads, kHeads, kComputeOwners, offsets, 0, head,
                                         0, KcpSummary32::kScratchBytes, head};
    RunKSide(inputs, schedule);
}

#if defined(__DAV_C310_CUBE__)
__aicore__ inline void AffineProduct(GM_ADDR summary, GM_ADDR initial)
{
    TPipe pipe;
    KcpState::ChunkGemmTiles<128, 128, float> gemm;
    gemm.Init(pipe);
    CrossCoreWaitFlag<4, PIPE_MTE2>(kMergeInput);
    CrossCoreWaitFlag<4, PIPE_MTE2>(kMergeInput + 16);
    if (summary == nullptr) {
        gemm.RunToUbFromL1Lhs<128, 128, 128, float>(KcpSummary32::kAffineMatrixL1, initial, kMergeProductUb);
    } else {
        gemm.RunToUb<128, 128, 128, float>(summary + 128 * sizeof(float), initial, kMergeProductUb, 256);
    }
    CrossCoreSetFlag<4, PIPE_FIX>(kMergeOutput);
    CrossCoreSetFlag<4, PIPE_FIX>(kMergeOutput + 16);
}
#else
__aicore__ inline void PublishAffine(GM_ADDR summary, GM_ADDR outgoing,
                                    uint32_t lane, bool available)
{
    CrossCoreSetFlag<4, PIPE_MTE3>(kMergeInput);
    CrossCoreWaitFlag<4, PIPE_MTE2>(kMergeOutput);
    if (!available) {
        return;
    }
    constexpr uint32_t kDim = 128;
    constexpr uint32_t kRowsPerTile = 16;
    constexpr uint32_t kTile = kDim * kRowsPerTile;
    constexpr uint32_t kRowsPerLane = kDim / 2;
    const DataCopyParams gather{kRowsPerTile, kDim * sizeof(float) / 32, kDim * sizeof(float) / 32, 0};
    LocalTensor<float> local(TPosition::VECCALC, 0, kTile);
    LocalTensor<float> product(TPosition::VECCALC, kMergeProductUb, kRowsPerLane * kDim);
    GlobalTensor<float> e, dest;
    if (summary != nullptr) {
        e.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(summary));
    }
    LocalTensor<float> residentE(TPosition::VECCALC, KcpSummary32::kStateUb, kRowsPerLane * 2 * kDim);
    dest.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outgoing));
    for (uint32_t row = 0; row < kRowsPerLane; row += kRowsPerTile) {
        const uint32_t offset = (lane * kRowsPerLane + row) * kDim;
        auto update = product[row * kDim];
        if (summary == nullptr) {
            DataCopy(local, residentE[2 * row * kDim], gather);
        } else {
            DataCopy(local, e[2 * offset], gather);
        }
        PipeBarrier<PIPE_ALL>();
        Add(local, local, update, kTile);
        PipeBarrier<PIPE_ALL>();
        DataCopy(dest[offset], local, kTile);
        PipeBarrier<PIPE_ALL>();
    }
}
#endif
#endif
}

extern "C" __global__ __aicore__ void kcp_ipc_chunk32_forward(
    GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR gate, GM_ADDR beta, GM_ADDR alpha, GM_ADDR bias,
    GM_ADDR offsets, GM_ADDR output, GM_ADDR finalState, GM_ADDR status, GM_ADDR inbox,
    GM_ADDR next, GM_ADDR previous, GM_ADDR scratch, GM_ADDR symmetric, uint32_t tokens, uint32_t rank, uint32_t world,
    uint32_t epoch, uint32_t saveFinal, uint32_t statusIndex)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__DAV_C310_CUBE__) || defined(__DAV_C310_VEC__)
    if (world != 8) {
        return;
    }
    const uint32_t windows = (tokens + tokens_per_group - 1) / tokens_per_group;
#if defined(KCP_IPC_PHASE_TRACE) && defined(__DAV_C310_VEC__)
    const auto summaryStart = GetSystemCycle();
#endif
#if defined(__DAV_C310_CUBE__)
    const uint32_t owner = GetBlockIdx();
#else
    const uint32_t owner = GetBlockIdx() / GetSubBlockNum();
#endif
    const HeadAssignment task = Assignment(rank, owner);
    GM_ADDR summary = nullptr;
    GM_ADDR worker = nullptr;
    if (task.summarySlot >= 0) {
        const uint32_t slot = static_cast<uint32_t>(task.summarySlot);
        if (task.second >= 0) {
            summary = scratch + slot * kSummaryBytes;
        }
        worker = scratch + PayloadWorkers(rank) * kSummaryBytes + slot * kSummaryWorker;
        SummarizeHead(k, v, gate, beta, alpha, bias, offsets, summary, worker, tokens,
                      static_cast<uint32_t>(task.summarize));
    }
#if defined(KCP_IPC_STATE_PREVIEW)
    const bool preview = rank > 0 && rank + 1 < world;
#endif
#if defined(__DAV_C310_CUBE__)
#if defined(KCP_IPC_BATCH_RELAY)
    if (GetBlockIdx() >= kOwners) {
        return;
    }
#endif
    Kernel<bfloat16_t> forward;
    const uint32_t taskCount = task.second < 0 ? 1 : 2;
    for (uint32_t index = 0; index < taskCount; ++index) {
        const uint32_t head = index == 0 ? task.first : task.second;
#if defined(KCP_IPC_STATE_PREVIEW)
        if (preview) {
            PreviewState(k, v, gate, beta, alpha, bias, offsets, scratch, nullptr, nullptr, tokens, batch);
        }
#endif
#if defined(KCP_IPC_AFFINE_RELAY)
        if (static_cast<int32_t>(head) == task.summarize) {
            AffineProduct(summary, inbox + head * kStateBytes);
        }
#endif
        forward.Init();
        forward.ProcessTask(windows);
    }
#elif defined(__DAV_C310_VEC__)
#if defined(KCP_IPC_PHASE_TRACE)
    const uint32_t summaryCycles = GetSystemCycle() - summaryStart;
#endif
    const uint32_t lane = GetSubBlockIdx();
#if defined(KCP_IPC_BATCH_RELAY)
    if (owner >= kOwners) {
        if (lane == 0) {
            RelayBatches(inbox, next, scratch, symmetric, rank, epoch);
        }
#if defined(KCP_SHMEM_UDMA_ONLY)
        else {
            ReceiveAndAcknowledge(inbox, symmetric, status, rank, epoch);
        }
#endif
        return;
    }
#endif
    Kernel<bfloat16_t, true, true> forward;
    constexpr float scale = 0.08838834764831845f;
    union { float value; uint32_t bits; } scaleBits{scale}, gateBits{-5.0f}, epsBits{1.0e-6f};
    const uint32_t taskCount = task.second < 0 ? 1 : 2;
    for (uint32_t index = 0; index < taskCount; ++index) {
        const uint32_t head = index == 0 ? task.first : task.second;
        const uint32_t signal = SignalOffset(head / kOwners, head % kOwners, lane);
#if defined(KCP_IPC_PHASE_TRACE)
        const auto waitStart = GetSystemCycle();
        uint32_t notifyCycles = 0;
#endif
#if defined(KCP_IPC_FIRST_PAIR)
        forward.Init(windows, scaleBits.bits >> 16, gateBits.bits, alpha, gate, q, k, v, beta,
                     bias, output, output, nullptr, finalState, 0, saveFinal, tokens,
                     1, kHeads, kHeads, kComputeOwners, 2,
                     reinterpret_cast<uint64_t>(offsets), epsBits.bits, 3);
        forward.template BindTaskVarlen<int32_t, true>(head);
        const bool firstPairReady = rank > 0;
        if (firstPairReady) {
            forward.PrepareBoundTaskFirstPair();
        }
#else
        constexpr bool firstPairReady = false;
#endif
#if defined(KCP_IPC_PHASE_TRACE)
        const auto waitBegin = GetSystemCycle();
#endif
        const uint32_t base = head * kStateBytes;
#if defined(KCP_IPC_BATCH_RELAY)
        const bool received = rank == 0 || Ready(inbox + kReadyBase + batch * kBatchSignalBytes, epoch);
        const bool available = received;
        GM_ADDR incoming = symmetric == nullptr ? inbox : symmetric;
        GM_ADDR send = symmetric == nullptr ? scratch : symmetric + kShmemSendBase;
        GM_ADDR outgoing = next != nullptr && available ? send + base : nullptr;
#else
        const bool received = rank == 0 || Ready(inbox + kReadyBase + signal, epoch);
        const bool credit = next == nullptr || epoch == 1 || Ready(inbox + kCreditBase + signal, epoch - 1);
        const bool available = received && credit;
        GM_ADDR incoming = inbox;
        GM_ADDR outgoing = rank + 1 < world && available ? next + base : nullptr;
#endif
#if defined(KCP_IPC_PHASE_TRACE)
        const auto applyStart = GetSystemCycle();
#endif
#if defined(KCP_IPC_STATE_PREVIEW)
        if (preview) {
            GM_ADDR initialBatch = received ? inbox + batch * kBatchBytes : nullptr;
            GM_ADDR outgoingBatch = outgoing == nullptr ? nullptr : next + batch * kBatchBytes;
            PreviewState(k, v, gate, beta, alpha, bias, offsets, scratch, initialBatch,
                         outgoingBatch, tokens, batch);
            if (available) {
                Publish(next + kReadyBase + signal, epoch);
#if defined(KCP_IPC_PHASE_TRACE)
                notifyCycles = GetSystemCycle() - summaryStart;
#endif
            }
            outgoing = nullptr;
        }
#endif
#if defined(KCP_IPC_AFFINE_RELAY)
        if (static_cast<int32_t>(head) == task.summarize) {
            PublishAffine(summary, outgoing, lane, available);
            if (available) {
                Publish(next + kReadyBase + signal, epoch);
#if defined(KCP_IPC_PHASE_TRACE)
                notifyCycles = GetSystemCycle() - summaryStart;
#endif
            }
            outgoing = nullptr;
        }
#endif
#if defined(KCP_IPC_PHASE_TRACE)
        const auto forwardStart = GetSystemCycle();
#endif
#if !defined(KCP_IPC_FIRST_PAIR)
        forward.Init(windows, scaleBits.bits >> 16, gateBits.bits, alpha, gate, q, k, v, beta,
                     bias, output, output, nullptr, finalState, 0, saveFinal, tokens,
                     1, kHeads, kHeads, kComputeOwners, 2,
                     reinterpret_cast<uint64_t>(offsets), epsBits.bits, 3);
        forward.template BindTaskVarlen<int32_t, true>(head);
#endif
        if (rank > 0 && available) {
            forward.has_istate = 1;
            forward.istate_gm.SetGlobalBuffer(
                reinterpret_cast<__gm__ float*>(incoming + base) + lane * kHalfElements);
        }
#if defined(KCP_IPC_EARLY_CREDIT)
        GM_ADDR creditAddress = previous != nullptr && available ? previous + kCreditBase + signal : nullptr;
        forward.ProcessBoundTask(windows, false, outgoing, true, creditAddress, epoch);
#elif defined(KCP_IPC_EARLY_STATE)
        GM_ADDR readyAddress = outgoing == nullptr ? nullptr : next + kReadyBase + signal;
        forward.ProcessBoundTask(windows, false, outgoing, true, readyAddress, epoch);
#else
        forward.ProcessBoundTask(windows, firstPairReady, outgoing, true);
#endif
        PipeBarrier<PIPE_ALL>();
#if !defined(KCP_IPC_EARLY_STATE)
        if (outgoing != nullptr) {
#if defined(KCP_IPC_BATCH_RELAY)
            Publish(scratch + kProducedBase + signal, epoch);
#else
            Publish(next + kReadyBase + signal, epoch);
#if defined(KCP_IPC_PHASE_TRACE)
            notifyCycles = GetSystemCycle() - summaryStart;
#endif
#endif
        }
#endif
        if (available) {
#if !defined(KCP_IPC_EARLY_CREDIT) && !defined(KCP_SHMEM_UDMA_ONLY)
            if (previous != nullptr) {
                Publish(previous + kCreditBase + signal, epoch);
            }
#endif
#if defined(KCP_IPC_PHASE_TRACE)
            PublishCompletion(status + statusIndex * kSignalArea + signal, epoch, summaryCycles,
                              applyStart - waitStart, forwardStart - applyStart,
                              GetSystemCycle() - forwardStart, waitStart - summaryStart,
                              notifyCycles, waitBegin - waitStart);
#else
            Publish(status + statusIndex * kSignalArea + signal, epoch);
#endif
        }
    }
#endif
#endif
}

