/**
 * bench_fp32_mmad.asc —— 950PR 上 fp32 matmul（M_c @ m 形状）的实测
 *
 * 改写自官方样例 examples/02_simd_c_api/03_c_api/03_matrix_compute/mmad（场景3: float）。
 * 形状对应本算子的 M_c @ m: A[K,BK] x B[K,N] -> C[BK,N]，M=128 N=64 K=128。
 *
 * 用法: ./bench [iters] [hf32] [stage]
 *   iters : 重复次数
 *   hf32  : 0=关闭HF32(真FP32) 1=开启HF32
 *   stage : 0=只测 mmad  1=每轮含 L1->L0 重搬
 */
#include "acl/acl.h"
#include "c_api/asc_simd.h"

#ifndef ASCENDC_HOST_AICORE
#if defined(__CCE__) && __CCE__
#define ASCENDC_HOST_AICORE __host_aicore__
#else
#define ASCENDC_HOST_AICORE
#endif
#endif
#include "utils/std/cmath.h"

constexpr uint32_t BLOCK_CUBE = 16;
constexpr uint32_t M = 128;   // = K (M_c 的行)
constexpr uint32_t N = 64;    // m 的列块
constexpr uint32_t K = 128;   // = K (M_c 的 K 维)
constexpr uint32_t C0 = 8;    // fp32: 32B / 4B

ASCENDC_HOST_AICORE inline constexpr uint32_t ceil_align(uint32_t v, uint32_t a)
{
    return static_cast<uint32_t>(AscendC::Std::ceil_div(v, a) * a);
}

constexpr uint32_t A_L1_SIZE = ceil_align(K, BLOCK_CUBE) * ceil_align(M, C0 * 2);
constexpr uint32_t A_L0_SIZE = ceil_align(M, BLOCK_CUBE) * ceil_align(K, C0 * 2);
constexpr uint32_t B_L1_SIZE = ceil_align(N, BLOCK_CUBE) * ceil_align(K, C0);
constexpr uint32_t B_L0_SIZE = ceil_align(K, C0) * ceil_align(N, BLOCK_CUBE);
constexpr uint32_t C_L0_SIZE = ceil_align(M, BLOCK_CUBE) * ceil_align(N, BLOCK_CUBE);
constexpr uint32_t BIAS_BYTES = ceil_align(AscendC::Std::ceil_div(N * sizeof(float), 32), 2) * 32;
constexpr uint32_t BIAS_ELEMS = BIAS_BYTES / sizeof(float);

__global__ __cube__ void bench_kernel(__gm__ float* a, __gm__ float* b, __gm__ float* bias,
                                      __gm__ float* c, uint32_t iters, uint32_t hf32, uint32_t stage)
{
    asc_init();
    __cbuf__ float a_l1[A_L1_SIZE];
    __cbuf__ float b_l1[B_L1_SIZE];
    __cbuf__ float bias_l1[BIAS_ELEMS];
    __ca__ float a_l0[A_L0_SIZE];
    __cb__ float b_l0[B_L0_SIZE];
    __cc__ float c_l0[C_L0_SIZE];

    if (hf32 != 0) {
        asc_enable_hf32();
        asc_set_hf32_round_mode(asc_hf32_round_mode::NEAREST_EVEN);
    } else {
        asc_disable_hf32();
    }

    // ---- GM -> L1
    asc_set_gm2l1_nz_para(1, 1, ceil_align(K, BLOCK_CUBE), 0);
    asc_copy_gm2l1_nd2nz(a_l1, a, M * sizeof(float),
                         asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, K, M, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_set_gm2l1_nz_para(1, 1, ceil_align(N, BLOCK_CUBE), 0);
    asc_copy_gm2l1_nd2nz(b_l1, b, K * sizeof(float),
                         asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, N, K, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
    asc_set_gm2l1_nz_para(1, 1, 1, 0);
    asc_copy_gm2l1_nd2nz(bias_l1, bias, N * sizeof(float),
                         asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, 1, N, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);

    // ---- L1 -> L0
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_copy_l12l0a_transpose(a_l0, a_l1, 0, 0, AscendC::Std::ceil_div(K, BLOCK_CUBE),
                              ceil_align(AscendC::Std::ceil_div(M, C0), 2),
                              AscendC::Std::ceil_div(K, BLOCK_CUBE),
                              AscendC::Std::ceil_div(M, C0 * 2));
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
    asc_copy_l12l0b(b_l0, b_l1, 0, 0, AscendC::Std::ceil_div(N, BLOCK_CUBE),
                    AscendC::Std::ceil_div(K, C0), AscendC::Std::ceil_div(N, BLOCK_CUBE),
                    AscendC::Std::ceil_div(N, BLOCK_CUBE));
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID2);
    asc_copy_l12bt(0, bias_l1, BIAS_BYTES);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID2);

    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID2);

    // ---- 计时循环
    for (uint32_t i = 0; i < iters; ++i) {
        if (stage != 0) {
            asc_copy_l12l0a_transpose(a_l0, a_l1, 0, 0, AscendC::Std::ceil_div(K, BLOCK_CUBE),
                                      ceil_align(AscendC::Std::ceil_div(M, C0), 2),
                                      AscendC::Std::ceil_div(K, BLOCK_CUBE),
                                      AscendC::Std::ceil_div(M, C0 * 2));
            asc_copy_l12l0b(b_l0, b_l1, 0, 0, AscendC::Std::ceil_div(N, BLOCK_CUBE),
                            AscendC::Std::ceil_div(K, C0), AscendC::Std::ceil_div(N, BLOCK_CUBE),
                            AscendC::Std::ceil_div(N, BLOCK_CUBE));
            asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
        }
        uint64_t bias_addr = 0;
        asc_mmad(c_l0, a_l0, b_l0, bias_addr, M, K, N, asc_unit_flag_mode::DISABLE, false);
    }
    asc_sync_pipe(PIPE_ALL);

    asc_set_l0c2gm_nz2nd(1, 0, 0);
    asc_copy_l0c2gm(c, c_l0, N, M, N, ceil_align(M, BLOCK_CUBE), 0, 0, 0, 0, 0, false, true, 0, 0, false,
                    0, false, false, false, false);
    asc_sync_pipe(PIPE_ALL);
}System.Management.Automation.Internal.Host.InternalHost
// ==================================================================
// Host 端：计时
// ==================================================================
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <vector>

#define CHECK_ACL(expr)                                                                       \
    do {                                                                                      \
        auto __ret = (expr);                                                                  \
        int32_t __code = static_cast<int32_t>(__ret);                                         \
        if (__code != 0) {                                                                    \
            fprintf(stderr, "[ERROR] %s failed at %s:%d ret=%d\n", #expr, __FILE__, __LINE__,  \
                    __code);                                                                  \
            exit(1);                                                                          \
        }                                                                                     \
    } while (0)

static double run_once(aclrtStream stream, uint8_t* a, uint8_t* b, uint8_t* bias, uint8_t* c,
                       uint32_t iters, uint32_t hf32, uint32_t stage)
{
    auto t0 = std::chrono::steady_clock::now();
    bench_kernel<<<1, 0, stream>>>((__gm__ float*)a, (__gm__ float*)b, (__gm__ float*)bias,
                                   (__gm__ float*)c, iters, hf32, stage);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    auto t1 = std::chrono::steady_clock::now();
    return std::chrono::duration<double, std::micro>(t1 - t0).count();
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t iters = (argc > 1) ? (uint32_t)atoi(argv[1]) : 1000;
    uint32_t hf32 = (argc > 2) ? (uint32_t)atoi(argv[2]) : 0;
    uint32_t stage = (argc > 3) ? (uint32_t)atoi(argv[3]) : 0;

    size_t a_sz = (size_t)M * K * sizeof(float);
    size_t b_sz = (size_t)K * N * sizeof(float);
    size_t bias_sz = (size_t)N * sizeof(float);
    size_t c_sz = (size_t)M * N * sizeof(float);

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    void *a_d = nullptr, *b_d = nullptr, *bias_d = nullptr, *c_d = nullptr;
    CHECK_ACL(aclrtMalloc(&a_d, a_sz, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&b_d, b_sz, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&bias_d, bias_sz, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&c_d, c_sz, ACL_MEM_MALLOC_HUGE_FIRST));

    std::vector<float> a_h((size_t)M * K), b_h((size_t)K * N), bias_h((size_t)N, 0.0f);
    for (size_t i = 0; i < a_h.size(); ++i) a_h[i] = 0.001f * (float)(i % 97);
    for (size_t i = 0; i < b_h.size(); ++i) b_h[i] = 0.001f * (float)(i % 89);
    CHECK_ACL(aclrtMemcpy(a_d, a_sz, a_h.data(), a_sz, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(b_d, b_sz, b_h.data(), b_sz, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(bias_d, bias_sz, bias_h.data(), bias_sz, ACL_MEMCPY_HOST_TO_DEVICE));

    run_once(stream, (uint8_t*)a_d, (uint8_t*)b_d, (uint8_t*)bias_d, (uint8_t*)c_d, 10, hf32, stage);
    double t0 = run_once(stream, (uint8_t*)a_d, (uint8_t*)b_d, (uint8_t*)bias_d, (uint8_t*)c_d,
                         0, hf32, stage);
    double tn = run_once(stream, (uint8_t*)a_d, (uint8_t*)b_d, (uint8_t*)bias_d, (uint8_t*)c_d,
                         iters, hf32, stage);
    double per = (tn - t0) / (double)iters;

    const char* hf32_s = hf32 ? "HF32(10bit)" : "FP32-native";
    const char* stage_s = stage ? "+L1toL0" : "mmad-only";
    printf("M=%u N=%u K=%u  iters=%u  mode=%s %s\n", M, N, K, iters, hf32_s, stage_s);
    printf("  launch_overhead = %.2f us\n", t0);
    printf("  total           = %.2f us\n", tn);
    printf("  per_mmad        = %.4f us   (= %.1f cycles @1.65GHz)\n", per, per * 1.65e3);
    printf("  throughput      = %.1f GMAC/s  (%.1f TFLOPS)\n",
           (double)M * N * K / per / 1e3, 2.0 * (double)M * N * K / per / 1e6);

    aclrtFree(a_d); aclrtFree(b_d); aclrtFree(bias_d); aclrtFree(c_d);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}