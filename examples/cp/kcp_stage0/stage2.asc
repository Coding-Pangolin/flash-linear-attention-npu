#include "stage2_prepare.h"
#include "chunk_state.h"
#include "chunk_scores.h"
#include "chunk_preprocess.h"
#include "check_runtime.h"

#include <array>

using namespace KcpPrepare;

namespace {
constexpr uint32_t kGroups = 3;
constexpr float kScale = 0.08838834764831845f;
constexpr std::array<int32_t, 8> kSizes{64, 1, 64, 33, 64, 9, 64, 31};
constexpr uint16_t kUntouched = 0x3f80;
constexpr uint32_t kNormBytes = kFeatureElements * sizeof(bfloat16_t);
constexpr uint32_t kGateBytes = kFeatureElements * sizeof(float);
constexpr uint32_t kPreprocessBytes = 2 * kNormBytes + kGateBytes + kChunk * kBetaStride * sizeof(float);

__aicore__ inline Window GetWindow(GM_ADDR k, GM_ADDR v, GM_ADDR gate, GM_ADDR beta,
    GM_ADDR kk, GM_ADDR q, GM_ADDR qk, GM_ADDR factors, GM_ADDR decay,
    uint32_t input, uint32_t scoreIndex, uint32_t bank)
{
    const uint64_t feature = static_cast<uint64_t>(input) * kFeatureElements;
    const uint64_t score = static_cast<uint64_t>(scoreIndex) * kScoreElements;
    return {k + feature * sizeof(bfloat16_t), v + feature * sizeof(bfloat16_t),
            gate + feature * sizeof(float), beta + input * kChunk * kBetaStride * sizeof(float),
            kk + score * sizeof(float), q + feature * sizeof(bfloat16_t), qk + score * sizeof(float),
            factors + bank * kOutputElements * sizeof(bfloat16_t), decay + bank * kDim * sizeof(float)};
}
} // namespace

extern "C" __global__ __aicore__ void kcp_stage2_prepare_check(
    GM_ADDR k, GM_ADDR v, GM_ADDR gate, GM_ADDR beta, GM_ADDR kk, GM_ADDR q, GM_ADDR qk,
    GM_ADDR settings, GM_ADDR factors, GM_ADDR decay)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if ASCEND_IS_AIV {
        auto* meta = reinterpret_cast<__gm__ const uint32_t*>(settings);
        const uint32_t lane = AscendC::GetSubBlockIdx();
        const uint32_t owner = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        AscendC::TPipe pipe;
        TriangularPrepare prep;
        prep.Init(pipe);
        for (uint32_t work = owner; work < meta[0]; work += kGroups) {
            const Window window = GetWindow(k, v, gate, beta, kk, q, qk, factors, decay, work, work, work);
            prep.Run(window, meta[1 + work], lane, (work & 1) != 0, kScale);
        }
    }
}

extern "C" __global__ __aicore__ void kcp_stage2_state_check(
    GM_ADDR k, GM_ADDR v, GM_ADDR rawGate, GM_ADDR rawBeta, GM_ADDR q, GM_ADDR aLog, GM_ADDR bias,
    GM_ADDR settings, GM_ADDR localInputs, GM_ADDR factors, GM_ADDR decay,
    GM_ADDR scratch, GM_ADDR scoreScratch, GM_ADDR dense,
    GM_ADDR stateE, GM_ADDR matrix, GM_ADDR stateH, GM_ADDR output)
{
    using namespace KcpState;
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    const auto* meta = reinterpret_cast<__gm__ const uint32_t*>(settings);
    if ASCEND_IS_AIV {
        const uint32_t lane = AscendC::GetSubBlockIdx();
        const uint32_t owner = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        const auto tmp = MakeStateScratch(scratch + owner * kScratchBytes);
        const auto scoreTmp = KcpScore::MakeScratch(scoreScratch + owner * KcpScore::kScratchBytes);
        GM_ADDR kk = dense + owner * 2 * kScoreElements * sizeof(float);
        GM_ADDR qk = kk + kScoreElements * sizeof(float);
        GM_ADDR qhat = localInputs + owner * kPreprocessBytes;
        GM_ADDR khat = qhat + kNormBytes;
        GM_ADDR gate = khat + kNormBytes;
        GM_ADDR beta = gate + kGateBytes;
        AscendC::TPipe pipe;
        KcpPreprocess::Stage0 preprocess;
        TriangularPrepare prep;
        StateVector state;
        KcpScore::ScoreVector score;
        preprocess.Init(pipe);
        preprocess.Bind({q, k, rawGate, rawBeta, aLog, bias, qhat, khat, gate, beta}, true);
        prep.Init(pipe);
        state.Init(pipe);
        score.Init(pipe);
        for (uint32_t task = owner; task < meta[0] / 2; task += kGroups) {
            for (uint32_t work = 2 * task; work < 2 * task + 2; ++work) {
                const uint64_t inputOffset = static_cast<uint64_t>(work) * kFeatureElements * sizeof(bfloat16_t);
                const auto window = GetWindow(khat, v + inputOffset, gate, beta, kk, qhat, qk, factors, decay,
                                              0, 0, owner);
                const uint32_t rows = meta[1 + work];
                const uint32_t offset = task * kStateElements * sizeof(float);
                // This diagnostic consumes the same prepared window from
                // zero-start E and from an independent nonzero true state.
                preprocess.PrepareWindow(work * kChunk, work * kChunk, 0, 1, 1, rows, 0, lane, true);
                score.Run(scoreTmp, window, rows, lane, true);
                prep.Run(window, rows, lane, true, kScale);
                state.Run(tmp, window.factors, window.decay, stateE + offset, nullptr, rows, lane, false,
                          matrix + offset);
                state.Run(tmp, window.factors, window.decay, stateH + offset,
                          output + work * kFeatureElements * sizeof(bfloat16_t), rows, lane, true);
            }
        }
    }
    if ASCEND_IS_AIC {
        const uint32_t owner = AscendC::GetBlockIdx();
        const auto tmp = MakeStateScratch(scratch + owner * kScratchBytes);
        const auto scoreTmp = KcpScore::MakeScratch(scoreScratch + owner * KcpScore::kScratchBytes);
        GM_ADDR prepared = factors + owner * kOutputElements * sizeof(bfloat16_t);
        AscendC::TPipe pipe;
        ChunkGemm gemm;
        gemm.Init(pipe);
        for (uint32_t task = owner; task < meta[0] / 2; task += kGroups) {
            for (uint32_t window = 0; window < 2; ++window) {
                KcpScore::RunCube(gemm, scoreTmp, meta[1 + 2 * task + window], true);
                RunStateCube(gemm, tmp, prepared, false, matrix + task * kStateElements * sizeof(float));
                WaitBoth<StateVector::kStateFree>();
                RunStateCube(gemm, tmp, prepared, true);
                WaitBoth<StateVector::kStateFree>();
            }
        }
    }
}

namespace {
void TokenReference(const uint16_t* k, const uint16_t* v, const uint16_t* q, const float* gate,
                    const float* beta, uint32_t rows, double* state, double* output)
{
    for (uint32_t token = 0; token < rows; ++token) {
        const uint32_t start = token * kDim;
        double corrected[kDim];
        for (uint32_t col = 0; col < kDim; ++col) {
            corrected[col] = v ? FromBf16(v[start + col]) : 0.0;
        }
        for (uint32_t key = 0; key < kDim; ++key) {
            const double step = gate[start + key] - (token == 0 ? 0.0 : gate[start + key - kDim]);
            const double decay = std::exp2(step);
            const double keyValue = FromBf16(k[start + key]);
            for (uint32_t col = 0; col < kDim; ++col) {
                double& h = state[key * kDim + col];
                h *= decay;
                corrected[col] -= keyValue * h;
            }
        }
        for (uint32_t key = 0; key < kDim; ++key) {
            const double update = beta[token * kBetaStride] * FromBf16(k[start + key]);
            const double query = output ? kScale * FromBf16(q[start + key]) : 0.0;
            for (uint32_t col = 0; col < kDim; ++col) {
                const double h = (state[key * kDim + col] += update * corrected[col]);
                if (output) {
                    output[start + col] += query * h;
                }
            }
        }
    }
}

void CheckWindows(Device& device)
{
    constexpr uint32_t kWorks = kSizes.size();
    const uint32_t featureCount = kWorks * kFeatureElements;
    const uint32_t scoreCount = kWorks * kScoreElements;
    std::vector<uint32_t> settings{kWorks};
    std::vector<uint16_t> k(featureCount), q(featureCount), v(featureCount);
    std::vector<uint16_t> kRaw(featureCount), qRaw(featureCount);
    std::vector<uint16_t> expected(kWorks * kOutputElements, kUntouched);
    std::vector<float> gate(featureCount), beta(kWorks * kChunk * kBetaStride);
    std::vector<float> gRaw(featureCount), bRaw(kWorks * kChunk);
    std::vector<float> kk(scoreCount), qk(scoreCount), decay(kWorks * kDim);
    for (uint32_t w = 0; w < kWorks; ++w) {
        const uint32_t size = kSizes[w];
        const bool forward = (w & 1) != 0;
        settings.push_back(size);
        const uint32_t feature = w * kFeatureElements;
        const uint32_t score = w * kScoreElements;
        auto* out = expected.data() + w * kOutputElements;
        std::fill_n(out, forward ? kOutputElements : 3 * kFeatureElements, uint16_t{0});
        double solutionW[kChunk][kDim]{};
        double solutionU[kChunk][kDim]{};
        for (uint32_t t = 0; t < size; ++t) {
            const uint32_t token = w * kChunk + t;
            beta[token * kBetaStride] = 0.1f + 0.8f * ((token * 13) % 31) / 30.0f;
            const float b = beta[token * kBetaStride];
            bRaw[token] = std::log(b / (1 - b));
            double qNorm = KcpPreprocess::kEpsilon, kNorm = KcpPreprocess::kEpsilon;
            for (uint32_t col = 0; col < kDim; ++col) {
                const uint32_t i = feature + t * kDim + col;
                kRaw[i] = ToBf16((static_cast<int32_t>((t * 37 + col * 11 + w) % 67) - 33) / 220.0f);
                qRaw[i] = ToBf16((static_cast<int32_t>((t * 11 + col * 19 + w) % 61) - 30) / 230.0f);
                v[i] = ToBf16((static_cast<int32_t>((t * 19 + col * 23 + w) % 59) - 29) / 170.0f);
                qNorm += static_cast<double>(FromBf16(qRaw[i])) * FromBf16(qRaw[i]);
                kNorm += static_cast<double>(FromBf16(kRaw[i])) * FromBf16(kRaw[i]);
                // Include moderate gates and strong decay; every exponent
                // used by Prepare is nonpositive.
                const float slope = (col % 4 == 0 ? 2.0f : 0.01f) + 0.003f * (col % 31);
                gate[i] = -(t + 1.0f) * slope;
                const float sig = slope / (5.0f * KcpPreprocess::kLog2e);
                gRaw[i] = std::log(sig / (1 - sig));
            }
            for (uint32_t col = 0; col < kDim; ++col) {
                const uint32_t i = feature + t * kDim + col;
                k[i] = ToBf16(static_cast<float>(FromBf16(kRaw[i]) / std::sqrt(kNorm)));
                q[i] = ToBf16(static_cast<float>(FromBf16(qRaw[i]) / std::sqrt(qNorm)));
            }
        }
        for (uint32_t col = 0; col < kDim; ++col) {
            decay[w * kDim + col] = std::exp2(gate[feature + (size - 1) * kDim + col]);
        }
        for (uint32_t t = 0; t < size; ++t) {
            const double b = beta[(w * kChunk + t) * kBetaStride];
            for (uint32_t j = 0; j <= t; ++j) {
                double keyScore = 0, queryScore = 0;
                for (uint32_t col = 0; col < kDim; ++col) {
                    const uint32_t dst = feature + t * kDim + col;
                    const uint32_t src = feature + j * kDim + col;
                    const double scaledKey = FromBf16(k[src]) *
                        std::exp2(static_cast<double>(gate[dst]) - gate[src]);
                    keyScore += FromBf16(k[dst]) * scaledKey;
                    queryScore += FromBf16(q[dst]) * scaledKey;
                }
                kk[score + t * kChunk + j] = static_cast<float>(keyScore);
                qk[score + t * kChunk + j] = static_cast<float>(queryScore);
                if (forward) {
                    out[4 * kFeatureElements + t * kChunk + j] =
                        ToBf16(qk[score + t * kChunk + j] * kScale);
                }
            }
            for (uint32_t col = 0; col < kDim; ++col) {
                const uint32_t offset = t * kDim + col;
                const uint32_t i = feature + offset;
                const double d = std::exp2(static_cast<double>(gate[i]));
                double wt = b * FromBf16(k[i]) * d;
                double ut = b * FromBf16(v[i]);
                for (uint32_t j = 0; j < t; ++j) {
                    const double f = b * kk[score + t * kChunk + j];
                    wt -= f * solutionW[j][col];
                    ut -= f * solutionU[j][col];
                }
                solutionW[t][col] = wt;
                solutionU[t][col] = ut;
                out[offset] = ToBf16(static_cast<float>(wt));
                out[kFeatureElements + offset] = ToBf16(static_cast<float>(ut));
                const double end = gate[feature + (size - 1) * kDim + col];
                out[2 * kFeatureElements + offset] =
                    ToBf16(static_cast<float>(FromBf16(k[i]) * std::exp2(end - gate[i])));
                if (forward) {
                    out[3 * kFeatureElements + offset] = ToBf16(static_cast<float>(kScale * FromBf16(q[i]) * d));
                }
            }
        }
    }

    Buffer<uint16_t> dk(featureCount), dq(featureCount), dv(featureCount), dout(expected.size());
    Buffer<float> dg(featureCount), db(beta.size()), dkk(scoreCount), dqk(scoreCount), dd(decay.size());
    Buffer<uint32_t> dm(settings.size());
    dk.Write(k);
    dq.Write(q);
    dv.Write(v);
    dg.Write(gate);
    db.Write(beta);
    dkk.Write(kk);
    dqk.Write(qk);
    dm.Write(settings);
    dout.Write(std::vector<uint16_t>(expected.size(), kUntouched));
    kcp_stage2_prepare_check<<<kGroups, nullptr, device.stream>>>(
        dk.Ptr(), dv.Ptr(), dg.Ptr(), db.Ptr(), dkk.Ptr(), dq.Ptr(), dqk.Ptr(), dm.Ptr(), dout.Ptr(), dd.Ptr());
    Check(aclrtSynchronizeStream(device.stream), "Stage 2 triangular prepare");
    const auto actual = dout.Read();
    const auto actualDecay = dd.Read();
    std::array<float, 5> error{};
    float decayError = 0;
    for (uint32_t w = 0; w < kWorks; ++w) {
        const uint32_t count = (w & 1) ? kOutputElements : 3 * kFeatureElements;
        for (uint32_t off = 0; off < kOutputElements; ++off) {
            const uint32_t i = w * kOutputElements + off;
            if (off >= count) {
                if (actual[i] != kUntouched) {
                    throw std::runtime_error("KFirst wrote a Q-side output");
                }
                continue;
            }
            const uint32_t field = off / kFeatureElements;
            const uint32_t row = (off % kFeatureElements) / (field == 4 ? kChunk : kDim);
            const double expectedValue = FromBf16(expected[i]);
            const bool padding = row >= static_cast<uint32_t>(kSizes[w]) ||
                (field == 4 && off % kChunk > row);
            const float diff = Verify(FromBf16(actual[i]), expectedValue, padding ? 0.0 : 0.00002,
                                      padding ? 0.0 : 0.008, "Stage 2 factor");
            error[field] = std::max(error[field], diff);
        }
    }
    for (uint32_t i = 0; i < decay.size(); ++i) {
        decayError = std::max(decayError, Verify(actualDecay[i], decay[i], 1e-6, 5e-6, "decay"));
    }
    std::cout << "stage2=PASS groups=" << kGroups << " windows=" << kWorks
              << " w_max_abs=" << error[0] << " u_max_abs=" << error[1]
              << " kg_max_abs=" << error[2] << " qs_max_abs=" << error[3]
              << " aqk_max_abs=" << error[4] << " decay_max_abs=" << decayError << '\n';

    using namespace KcpState;
    constexpr uint32_t kStates = (kWorks / 2) * kStateElements;
    std::vector<float> hIn(kStates), mIn(kStates);
    for (uint32_t i = 0; i < kStates; ++i) {
        hIn[i] = (static_cast<int>(i % 53) - 26) / 600.0f;
        mIn[i] = i % kDim == (i / kDim) % kDim ? 1.0f : 0.0f;
    }
    std::vector<double> hRef(hIn.begin(), hIn.end()), mRef(mIn.begin(), mIn.end()), eRef(kStates), oRef(featureCount);
    for (uint32_t w = 0; w < kWorks; ++w) {
        const uint32_t f = w * kFeatureElements;
        const uint32_t b = w * kChunk * kBetaStride;
        const uint32_t s = (w / 2) * kStateElements;
        TokenReference(k.data() + f, v.data() + f, nullptr, gate.data() + f,
                       beta.data() + b, kSizes[w], eRef.data() + s, nullptr);
        TokenReference(k.data() + f, nullptr, nullptr, gate.data() + f,
                       beta.data() + b, kSizes[w], mRef.data() + s, nullptr);
        TokenReference(k.data() + f, v.data() + f, q.data() + f, gate.data() + f,
                       beta.data() + b, kSizes[w], hRef.data() + s, oRef.data() + f);
    }
    Buffer<uint8_t> work(kGroups * kScratchBytes);
    Buffer<uint8_t> scoreScratch(kGroups * KcpScore::kScratchBytes);
    Buffer<uint8_t> localInputs(kGroups * kPreprocessBytes);
    Buffer<uint16_t> prepared(kGroups * kOutputElements), output(featureCount);
    Buffer<uint16_t> dKRaw(featureCount), dQRaw(featureCount);
    Buffer<float> dGRaw(featureCount), dBRaw(bRaw.size()), dALog(1), dBias(kDim);
    Buffer<float> d(kGroups * kDim), E(kStates), M(kStates), H(kStates), dense(kGroups * 2 * kScoreElements);
    dKRaw.Write(kRaw);
    dQRaw.Write(qRaw);
    dGRaw.Write(gRaw);
    dBRaw.Write(bRaw);
    dALog.Write({0.0f});
    dBias.Write(std::vector<float>(kDim, 0.0f));
    E.Write(std::vector<float>(kStates, 0.0f));
    M.Write(mIn);
    H.Write(hIn);
    output.Write(std::vector<uint16_t>(featureCount, kUntouched));
    kcp_stage2_state_check<<<kGroups, nullptr, device.stream>>>(
        dKRaw.Ptr(), dv.Ptr(), dGRaw.Ptr(), dBRaw.Ptr(), dQRaw.Ptr(), dALog.Ptr(), dBias.Ptr(),
        dm.Ptr(), localInputs.Ptr(), prepared.Ptr(), d.Ptr(), work.Ptr(), scoreScratch.Ptr(), dense.Ptr(),
        E.Ptr(), M.Ptr(), H.Ptr(), output.Ptr());
    Check(aclrtSynchronizeStream(device.stream), "Raw Prepare plus E/M and true forward");
    const auto actualE = E.Read();
    const auto actualM = M.Read();
    const auto actualH = H.Read();
    const auto actualO = output.Read();
    const auto localInput = localInputs.Read();
    const auto deviceFactors = prepared.Read();
    const auto deviceScores = dense.Read();
    for (uint32_t group = 0; group < kGroups; ++group) {
        uint32_t task = group;
        for (; task + kGroups < kWorks / 2; task += kGroups) {}
        const uint32_t window = 2 * task + 1;
        const auto* normBlock = localInput.data() + group * kPreprocessBytes;
        for (uint32_t row = 0; row < static_cast<uint32_t>(kSizes[window]); ++row) {
            float b;
            std::memcpy(&b, normBlock + 2 * kNormBytes + kGateBytes + row * kBetaStride * sizeof(float), sizeof(b));
            Verify(b, beta[(window * kChunk + row) * kBetaStride], 0.00001, 0.00001, "raw beta");
            for (uint32_t col = 0; col < kDim; ++col) {
                const uint32_t i = row * kDim + col;
                const uint32_t feature = window * kFeatureElements + i;
                float g;
                uint16_t key, query;
                std::memcpy(&key, normBlock + kNormBytes + i * sizeof(key), sizeof(key));
                std::memcpy(&query, normBlock + i * sizeof(query), sizeof(query));
                std::memcpy(&g, normBlock + 2 * kNormBytes + i * sizeof(g), sizeof(g));
                Verify(FromBf16(key), FromBf16(k[feature]), 0.0002, 0.008, "raw normalized key");
                Verify(FromBf16(query), FromBf16(q[feature]), 0.0002, 0.008, "raw normalized query");
                Verify(g, gate[feature], 0.0001, 0.00001, "raw gate");
            }
            for (uint32_t col = 0; col < row; ++col) {
                const uint32_t cell = row * kChunk + col;
                Verify(deviceScores[2 * group * kScoreElements + cell],
                       kk[window * kScoreElements + cell], 0.0008, 0.008, "raw KK score");
            }
            for (uint32_t col = 0; col <= row; ++col) {
                const uint32_t cell = row * kChunk + col;
                Verify(deviceScores[(2 * group + 1) * kScoreElements + cell],
                       qk[window * kScoreElements + cell], 0.0008, 0.008, "raw QK score");
            }
        }
        for (uint32_t cell = 0; cell < kOutputElements; ++cell) {
            Verify(FromBf16(deviceFactors[group * kOutputElements + cell]),
                   FromBf16(expected[window * kOutputElements + cell]), 0.0009, 0.02, "raw factor");
        }
    }
    float eError = 0, mError = 0, hError = 0, oError = 0;
    for (uint32_t i = 0; i < kStates; ++i) {
        eError = std::max(eError, Verify(actualE[i], eRef[i], 0.0008, 0.025, "summary E"));
        mError = std::max(mError, Verify(actualM[i], mRef[i], 0.0008, 0.025, "summary M"));
        hError = std::max(hError, Verify(actualH[i], hRef[i], 0.0008, 0.025, "true final H"));
    }
    for (uint32_t w = 0; w < kWorks; ++w) {
        for (uint32_t row = 0; row < kChunk; ++row) {
            for (uint32_t col = 0; col < kDim; ++col) {
                const uint32_t i = w * kFeatureElements + row * kDim + col;
                if (row >= static_cast<uint32_t>(kSizes[w])) {
                    if (actualO[i] != kUntouched) {
                        throw std::runtime_error("State path wrote a padded output row");
                    }
                    continue;
                }
                if (std::abs(FromBf16(actualO[i]) - oRef[i]) > 0.0005 + 0.025 * std::abs(oRef[i])) {
                    std::cerr << "Output location window=" << w << " row=" << row << " column=" << col << '\n';
                    if (row + 1 == static_cast<uint32_t>(kSizes[w]) && (w & 1) != 0) {
                        double fromState = 0;
                        for (uint32_t key = 0; key < kDim; ++key) {
                            fromState += FromBf16(q[w * kFeatureElements + row * kDim + key]) * kScale *
                                actualH[(w / 2) * kStateElements + key * kDim + col];
                        }
                        std::cerr << "Output reconstructed from device H=" << fromState << '\n';
                    }
                }
                oError = std::max(oError, Verify(FromBf16(actualO[i]), oRef[i], 0.0005, 0.025, "true token output"));
            }
        }
    }
    std::cout << "raw_state=PASS groups=" << kGroups << " tasks=" << kWorks / 2
              << " windows=" << kWorks << " e_max_abs=" << eError << " m_max_abs=" << mError << " h_max_abs=" << hError
              << " o_max_abs=" << oError << '\n';
}
} // namespace

int main()
{
    try {
        Device device;
        CheckWindows(device);
        return 0;
    } catch (const std::exception& e) {
        std::cerr << e.what() << '\n';
        return 1;
    }
}
