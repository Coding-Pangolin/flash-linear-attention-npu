#include "kernel_operator.h"
#include "check_runtime.h"
#include "chunk_scores.h"

namespace {
using KcpScore::kTile;
using KcpScore::kHead;
using KcpScore::kInputTile;
using KcpScore::kScoreTile;
using KcpScore::Rect;
constexpr uint16_t kFractal = 16;
constexpr uint32_t kGroups = 4;
constexpr uint32_t kBanks = 2;
constexpr uint16_t kFactorReady = 0;
constexpr uint16_t kFactorFree = 4;
constexpr uint16_t kSecondLane = 16;
__aicore__ inline void ProduceFactors(
    GM_ADDR x, GM_ADDR k, GM_ADDR logGate, GM_ADDR rectangles, uint32_t tiles,
    GM_ADDR left, GM_ADDR right)
{
    auto* desc = reinterpret_cast<__gm__ const Rect*>(rectangles);
    AscendC::TPipe pipe;
    KcpScore::Factors factors;
    factors.Init(pipe);
    const uint32_t owner = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
    const bool isRight = AscendC::GetSubBlockIdx() != 0;
    for (uint32_t tile = owner, pass = 0; tile < tiles; tile += kGroups, ++pass) {
        const uint16_t bank = pass % kBanks;
        const auto& r = desc[tile];
        const Rect rect{r.row, r.rows, r.col, r.cols, r.anchor};
        factors.Make(isRight ? k : x, logGate, rect, isRight);
        // Wait only when replacing an occupied GM bank. The local factor can
        // be formed while Cube is still consuming the previous generation.
        if (pass >= kBanks) {
            AscendC::CrossCoreWaitFlag<4, PIPE_MTE3>(kFactorFree + bank);
        }
        const uint32_t offset = (owner * kBanks + bank) * kInputTile;
        factors.Write((isRight ? right : left) + offset * sizeof(bfloat16_t));
        AscendC::CrossCoreSetFlag<4, PIPE_MTE3>(kFactorReady + bank);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

__aicore__ inline void ConsumeFactors(GM_ADDR left, GM_ADDR right, GM_ADDR score, uint32_t tiles)
{
    AscendC::GlobalTensor<bfloat16_t> a, b;
    AscendC::GlobalTensor<float> c;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(left));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(right));
    c.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(score));
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::A1> a1Buffer;
    AscendC::TBuf<AscendC::TPosition::B1> b1Buffer;
    AscendC::TBuf<AscendC::TPosition::A2> a2Buffer;
    AscendC::TBuf<AscendC::TPosition::B2> b2Buffer;
    AscendC::TBuf<AscendC::TPosition::CO1> cBuffer;
    pipe.InitBuffer(a1Buffer, kInputTile * sizeof(bfloat16_t));
    pipe.InitBuffer(b1Buffer, kInputTile * sizeof(bfloat16_t));
    pipe.InitBuffer(a2Buffer, kInputTile * sizeof(bfloat16_t));
    pipe.InitBuffer(b2Buffer, kInputTile * sizeof(bfloat16_t));
    pipe.InitBuffer(cBuffer, kScoreTile * sizeof(float));
    auto a1 = a1Buffer.Get<bfloat16_t>();
    auto b1 = b1Buffer.Get<bfloat16_t>();
    auto a2 = a2Buffer.Get<bfloat16_t>();
    auto b2 = b2Buffer.Get<bfloat16_t>();
    auto co = cBuffer.Get<float>();
    const uint32_t owner = AscendC::GetBlockIdx();
    for (uint32_t t = owner, pass = 0; t < tiles; t += kGroups, ++pass) {
        const uint16_t bank = pass % kBanks;
        const uint32_t offset = (owner * kBanks + bank) * kInputTile;
        AscendC::CrossCoreWaitFlag<4, PIPE_MTE2>(kFactorReady + bank);
        AscendC::CrossCoreWaitFlag<4, PIPE_MTE2>(kFactorReady + bank + kSecondLane);
        AscendC::DataCopy(a1, a[offset], AscendC::Nd2NzParams{1, kTile, kHead, 0, kHead, kTile, 1, 0});
        AscendC::DataCopy(b1, b[offset], AscendC::Nd2NzParams{1, kHead, kTile, 0, kTile, kHead, 1, 0});
        if (t + kBanks * kGroups < tiles) {
            // Only the GM read belongs to this bank. The L1 and L0 tiles
            // remain owned by Cube until its current score has been written.
            AscendC::CrossCoreSetFlag<4, PIPE_MTE2>(kFactorFree + bank);
            AscendC::CrossCoreSetFlag<4, PIPE_MTE2>(kFactorFree + bank + kSecondLane);
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(0);
        AscendC::LoadData(a2, a1, AscendC::LoadData2DParamsV2{
            0, 0, kTile / kFractal, kHead / kFractal, kTile / kFractal, kTile / kFractal, false, 0});
        AscendC::LoadData(b2, b1, AscendC::LoadData2DParamsV2{
            0, 0, kHead / kFractal, kTile / kFractal, kHead / kFractal, kTile / kFractal, true, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(0);
        AscendC::Mmad(co, a2, b2, AscendC::MmadParams{kTile, kTile, kHead, 0, false, true});
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(0);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(0);
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fix;
        fix.nSize = kTile;
        fix.mSize = kTile;
        fix.srcStride = kTile;
        fix.dstStride = kTile;
        fix.params.ndNum = 1;
        AscendC::Fixpipe<float, float, AscendC::CFG_ROW_MAJOR>(c[t * kScoreTile], co, fix);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
} // namespace

extern "C" __global__ __aicore__ void kcp_stage1_mix_check(
    GM_ADDR x, GM_ADDR k, GM_ADDR logGate, GM_ADDR rectangles, GM_ADDR count,
    GM_ADDR left, GM_ADDR right, GM_ADDR score)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    const uint32_t tiles = *reinterpret_cast<__gm__ uint32_t*>(count);
    if ASCEND_IS_AIV {
        ProduceFactors(x, k, logGate, rectangles, tiles, left, right);
    }
    if ASCEND_IS_AIC {
        ConsumeFactors(left, right, score, tiles);
    }
}

namespace {
void LowerTriangle(std::vector<Rect>& out, int begin, int end)
{
    if (end - begin == 1) {
        out.push_back({begin, 1, begin, 1, begin});
        return;
    }
    const int mid = (begin + end) / 2;
    out.push_back({mid, end - mid, begin, mid - begin, mid - 1});
    LowerTriangle(out, begin, mid);
    LowerTriangle(out, mid, end);
}

double Input(int t, int d, bool query)
{
    return FromBf16(ToBf16(static_cast<float>((t * 7 + d * (query ? 11 : 3)) % 47 - 23) / 231.0f));
}

double GatePrefix(int t, int d)
{
    return -(t + 1) * (0.08 + 0.013 * (d % 27));
}

void TestSize(Device& device, int tokens, bool query, float& cubeError, float& anchorError)
{
    std::vector<Rect> masks;
    LowerTriangle(masks, 0, tokens);
    const uint32_t count = masks.size();
    std::vector<uint16_t> a(count * kInputTile), b(count * kInputTile);
    std::vector<unsigned> coverage(tokens * tokens);
    for (uint32_t r = 0; r < count; ++r) {
        const auto tile = masks[r];
        for (int d = 0; d < kHead; ++d) {
            const double anchor = GatePrefix(tile.anchor, d);
            for (int i = 0; i < tile.rows; ++i) {
                const int row = tile.row + i;
                const double gate = GatePrefix(row, d);
                a[r * kInputTile + i * kHead + d] = ToBf16(Input(row, d, query) * std::exp2(gate - anchor));
            }
            for (int j = 0; j < tile.cols; ++j) {
                const int col = tile.col + j;
                const double gate = GatePrefix(col, d);
                b[r * kInputTile + d * kTile + j] = ToBf16(Input(col, d, false) * std::exp2(anchor - gate));
            }
        }
    }
    std::vector<uint16_t> x(tokens * kHead), k(tokens * kHead);
    std::vector<float> g(tokens * kHead);
    for (int token = 0; token < tokens; ++token) {
        for (int d = 0; d < kHead; ++d) {
            const uint32_t offset = token * kHead + d;
            x[offset] = ToBf16(Input(token, d, query));
            k[offset] = ToBf16(Input(token, d, false));
            g[offset] = static_cast<float>(GatePrefix(token, d));
        }
    }
    Buffer<uint16_t> dx(x.size()), dk(k.size());
    Buffer<uint16_t> da(kGroups * kBanks * kInputTile), db(kGroups * kBanks * kInputTile);
    Buffer<float> dg(g.size());
    Buffer<Rect> dRects(masks.size());
    Buffer<float> dc(count * kScoreTile);
    Buffer<uint32_t> dCount(1);
    dx.Write(x);
    dk.Write(k);
    dg.Write(g);
    dRects.Write(masks);
    dCount.Write({count});
    kcp_stage1_mix_check<<<kGroups, nullptr, device.stream>>>(
        dx.Ptr(), dk.Ptr(), dg.Ptr(), dRects.Ptr(), dCount.Ptr(), da.Ptr(), db.Ptr(), dc.Ptr());
    Check(aclrtSynchronizeStream(device.stream), "Stage 1 MIX kernel");
    const auto got = dc.Read();
    for (uint32_t r = 0; r < count; ++r) {
        const auto tile = masks[r];
        for (int i = 0; i < kTile; ++i) {
            for (int j = 0; j < kTile; ++j) {
                const auto idx = r * kScoreTile + i * kTile + j;
                if (i >= tile.rows || j >= tile.cols) {
                    Verify(got[idx], 0.0, 0.0, 0.0, "Cube padding");
                    continue;
                }
                const int row = tile.row + i;
                const int col = tile.col + j;
                ++coverage[row * tokens + col];
                double anchored = 0, direct = 0;
                for (int d = 0; d < kHead; ++d) {
                    anchored += static_cast<double>(FromBf16(a[r * kInputTile + i * kHead + d])) *
                                FromBf16(b[r * kInputTile + d * kTile + j]);
                    direct += Input(row, d, query) * Input(col, d, false) *
                              std::exp2(GatePrefix(row, d) - GatePrefix(col, d));
                }
                cubeError = std::max(cubeError, Verify(got[idx], anchored, 0.000001, 0.000002, "Cube score"));
                anchorError = std::max(anchorError, Verify(got[idx], direct, 0.0006, 0.006, "score BF16 anchor"));
            }
        }
    }
    for (int i = 0; i < tokens; ++i) {
        for (int j = 0; j < tokens; ++j) {
            if (coverage[i * tokens + j] != static_cast<unsigned>(i >= j)) {
                throw std::runtime_error("Incorrect causal tile coverage");
            }
        }
    }
}
} // namespace

int main()
{
    try {
        Device device;
        float cubeError = 0, anchorError = 0;
        for (int size : {1, 33, 64}) {
            TestSize(device, size, false, cubeError, anchorError);
            TestSize(device, size, true, cubeError, anchorError);
        }
        std::cout << "stage1=PASS groups=" << kGroups << " banks=" << kBanks
                  << " sizes=1,33,64 branches=KK,QK cube_max_abs=" << cubeError
                  << " anchor_max_abs=" << anchorError << '\n';
        return 0;
    } catch (const std::exception& e) {
        std::cerr << e.what() << '\n';
        return 1;
    }
}
